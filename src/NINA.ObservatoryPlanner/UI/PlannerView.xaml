<ResourceDictionary
    x:Class="NINA.ObservatoryPlanner.UI.PlannerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NINA.ObservatoryPlanner.UI"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        The panel fits the dock it sits in: a fixed top block (state and buttons, the stages, the status text), the tabs
        (Targets | Sequence | gear | !) and a scrolling page below. Rows and buttons rearrange by width (FirstFitPanel,
        ExposureRowPanel, SideBySidePanel in Layout.cs); the text size option scales the whole panel.
        Surfaces and text use NINA's theme brushes; the mockup's colours mark state (safe, target, imaging, end).
        Shared OP_* styles are also used by the planner's dialogs (this dictionary is merged into the application).
    -->

    <local:AtLeastVisibleConverter x:Key="OP_AtLeast" />
    <local:IndexVisibleConverter x:Key="OP_IndexVisible" />
    <local:AllVisibleConverter x:Key="OP_AllVisible" />
    <local:ScrollBarMarginConverter x:Key="OP_ScrollBarMargin" />
    <BooleanToVisibilityConverter x:Key="OP_BoolVisible" />
    <local:BoolCollapsedConverter x:Key="OP_BoolCollapsed" />
    <local:EqualsVisibleConverter x:Key="OP_EqualsVisible" />
    <local:TextVisibleConverter x:Key="OP_TextVisible" />
    <local:EnumBoolConverter x:Key="OP_EnumBool" />
    <local:PlusOneConverter x:Key="OP_PlusOne" />
    <local:TargetStateConverter x:Key="OP_TargetState" />

    <SolidColorBrush x:Key="OP_Safe" Color="#57B97C" />
    <SolidColorBrush x:Key="OP_Info" Color="#6AA7D8" />
    <SolidColorBrush x:Key="OP_Accent" Color="#E3A646" />
    <SolidColorBrush x:Key="OP_AccentInk" Color="#1A1306" />
    <SolidColorBrush x:Key="OP_Unsafe" Color="#E0645C" />
    <SolidColorBrush x:Key="OP_Muted" Color="#8B939C" />
    <FontFamily x:Key="OP_MonoFont">Consolas, Courier New</FontFamily>

    <Style x:Key="OP_Box" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style x:Key="OP_Heading" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style x:Key="OP_Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="OP_Hint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Opacity" Value="0.65" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="OP_Mono" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource OP_MonoFont}" />
    </Style>
    <Style x:Key="OP_WarnBox" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource OP_Unsafe}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="Background" Value="#1AE0645C" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="CornerRadius" Value="0,4,4,0" />
    </Style>
    <Style x:Key="OP_WarnText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OP_Unsafe}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="OP_Chip" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource TertiaryBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="0,2,6,2" />
    </Style>

    <!--  Buttons with their own template, so they look the same in the panel and the dialogs  -->
    <Style x:Key="OP_Btn" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="bd" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}">
                            <!--  NINA's theme gives every TextBlock light text; a text set directly keeps the button's own colour  -->
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type sys:String}">
                                    <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" Text="{Binding}" />
                                </DataTemplate>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource OP_Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource OP_Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="OP_Small" BasedOn="{StaticResource OP_Btn}" TargetType="ButtonBase">
        <Setter Property="Padding" Value="9,2" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style x:Key="OP_Primary" BasedOn="{StaticResource OP_Btn}" TargetType="ButtonBase">
        <Setter Property="Background" Value="{StaticResource OP_Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource OP_Accent}" />
        <Setter Property="Foreground" Value="{StaticResource OP_AccentInk}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="OP_Icon" BasedOn="{StaticResource OP_Btn}" TargetType="ButtonBase">
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style x:Key="OP_Flat" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="3,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="bd" Padding="{TemplateBinding Padding}" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
                        <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="OP_Link" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource OP_Info}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="t" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Content}" TextDecorations="Underline" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Foreground" Value="{StaticResource OP_Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Check box with its label shown (NINA's own check box is an ON/OFF switch without a label)  -->
    <Style x:Key="OP_Check" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!--  a DockPanel (not a StackPanel) so a long label wraps in the width it has  -->
                    <DockPanel Background="Transparent">
                        <Border x:Name="box" Width="16" Height="16" VerticalAlignment="Center" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" DockPanel.Dock="Left">
                            <Path x:Name="mark" Data="M3,8 L6.5,11.5 L12.5,4.5" Stroke="{StaticResource OP_AccentInk}" StrokeThickness="2" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter x:Name="label" Margin="7,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource OP_Accent}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource OP_Accent}" />
                            <Setter TargetName="mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource OP_Accent}" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="label" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="OP_Radio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,2,14,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <DockPanel Background="Transparent">
                        <Grid Width="16" Height="16" VerticalAlignment="Center" DockPanel.Dock="Left">
                            <Ellipse x:Name="ring" Fill="{DynamicResource BackgroundBrush}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" />
                            <Ellipse x:Name="dot" Width="8" Height="8" Fill="{StaticResource OP_Accent}" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ring" Property="Stroke" Value="{StaticResource OP_Accent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ring" Property="Stroke" Value="{StaticResource OP_Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--  Run mode cards  -->
    <Style x:Key="OP_Card" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" Padding="12,10" Background="{DynamicResource TertiaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource OP_Accent}" />
                            <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource OP_Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--  Phase chain steps  -->
    <Style x:Key="OP_Step" TargetType="Border">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}" />
        <Setter Property="Margin" Value="0,2,0,2" />
    </Style>
    <Style x:Key="OP_StepText" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource OP_Muted}" />
    </Style>
    <Style x:Key="OP_Arrow" TargetType="TextBlock">
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource OP_Muted}" />
    </Style>

    <!--  Icons (24 × 24 strokes, from the mockup)  -->
    <Style x:Key="OP_IconPath" TargetType="Path">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>

    <!--  Stage chips in the top block: orange while that stage runs (Tag = the stage's Step… flag)  -->
    <Style x:Key="OP_StageChip" BasedOn="{StaticResource OP_Step}" TargetType="Border">
        <Setter Property="Margin" Value="0,2,6,2" />
        <Setter Property="Padding" Value="8,3" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{StaticResource OP_Accent}" />
                <Setter Property="BorderBrush" Value="{StaticResource OP_Accent}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="OP_StageChipText" BasedOn="{StaticResource OP_StepText}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource OP_AccentInk}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!--  Bold section labels in the target details (DELAY:, ORDER:)  -->
    <Style x:Key="OP_Strong" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <!--  Small ▲ ▼ next to a number box  -->
    <Style x:Key="OP_Spin" TargetType="RepeatButton">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="12" />
        <Setter Property="FontSize" Value="7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Delay" Value="400" />
        <Setter Property="Interval" Value="60" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border x:Name="bd" Background="{DynamicResource ButtonBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="2">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Content}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource OP_Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--  Collapsible section: click the heading; the › turns when open  -->
    <Style x:Key="OP_SectionToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                        <DockPanel>
                            <TextBlock x:Name="chev" Width="14" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="17" Foreground="{StaticResource OP_Accent}" RenderTransformOrigin="0.5,0.5" Text="›" TextAlignment="Center" />
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="chev" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="OP_Section" TargetType="Expander">
        <Setter Property="IsExpanded" Value="True" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                        <DockPanel>
                            <ToggleButton Content="{TemplateBinding Header}" DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Style="{StaticResource OP_SectionToggle}" />
                            <ContentPresenter x:Name="body" Margin="12,0,12,12" Visibility="Collapsed" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="body" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--  Exposure table cells  -->
    <Style x:Key="OP_ColumnHead" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="OP_RowProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="8" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="Foreground" Value="{StaticResource OP_Accent}" />
        <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <!--  under the row: a thin line like the target list's  -->
            <Trigger Property="local:ExposureRowPanel.ProgressOnOwnLine" Value="True">
                <Setter Property="Height" Value="3" />
            </Trigger>
            <DataTrigger Binding="{Binding Remaining}" Value="0">
                <Setter Property="Foreground" Value="{StaticResource OP_Safe}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="OP_RowProgressText" BasedOn="{StaticResource OP_Mono}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Style.Triggers>
            <Trigger Property="local:ExposureRowPanel.ProgressOnOwnLine" Value="True">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Opacity" Value="0.65" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  Info guide text  -->
    <Style x:Key="OP_InfoText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Opacity" Value="0.85" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="Margin" Value="0,2,0,4" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="OP_InfoHead" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="OP_InfoBullet" BasedOn="{StaticResource OP_InfoText}" TargetType="TextBlock">
        <Setter Property="Margin" Value="10,2,0,4" />
    </Style>

    <DataTemplate x:Key="NINA.ObservatoryPlanner.UI.PlannerDockableVM_Dockable">
        <Grid Margin="8" Tag="OP_Root">
            <!--  the text size option scales the whole panel; the layout below works in these scaled units  -->
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding PanelScale}" ScaleY="{Binding PanelScale}" />
            </Grid.LayoutTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  ===== top block: state and buttons, the stages, the status text (stays put while the page scrolls) =====  -->
            <Border Grid.Row="0" Margin="0,0,0,8" Padding="12,10" Style="{StaticResource OP_Box}">
                <StackPanel>
                    <!--  line 1: state on the left, Pause / Start sequence and Run / Stop on the right  -->
                    <DockPanel>
                        <StackPanel VerticalAlignment="Center" DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Margin="0,0,8,0" Click="AddButton_Click" Content="⏸  Pause ▾" IsEnabled="{Binding PauseEnabled}" Style="{StaticResource OP_Small}" ToolTip="{Binding PauseTip}" ToolTipService.ShowOnDisabled="True" Visibility="{Binding PauseShown, Converter={StaticResource OP_BoolVisible}}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="{Binding PauseNowCommand}" Header="Pause now" ToolTip="Stops whatever is running: a frame being taken is dropped; a slew, centering, autofocus, a wait or 1 Begin is interrupted. A meridian flip, the dome shutter and park finish first." />
                                        <MenuItem Command="{Binding PauseAfterFrameCommand}" Header="Pause after this step" ToolTip="The frame or instruction running now finishes first, then it pauses." />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Margin="0,0,8,0" Click="AddButton_Click" Content="⏸  Pausing… ▾" Style="{StaticResource OP_Small}" ToolTip="A pause is due: after the current step, or once a meridian flip, the dome shutter or park has finished" Visibility="{Binding PausingShown, Converter={StaticResource OP_BoolVisible}}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="{Binding PauseNowCommand}" Header="Pause now" ToolTip="Stops whatever is running (a meridian flip, the dome shutter and park finish first)." />
                                        <MenuItem Command="{Binding CancelPauseCommand}" Header="Cancel the pause" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Margin="0,0,8,0" Padding="12,4" Command="{Binding ResumeCommand}" Content="▶  Start sequence" Style="{StaticResource OP_Primary}" ToolTip="Checks the connections and the weather, then continues with the targets and settings as they are now: an interrupted 1 Begin continues from the step it stopped at; on the same target with the mount not moved only guiding restarts; otherwise 2 Start of target runs." Visibility="{Binding IsPaused, Converter={StaticResource OP_BoolVisible}}" />
                            <Button MinWidth="120" Padding="14,5" Command="{Binding RunCommand}" Content="{Binding RunButtonText}" FontSize="14" ToolTip="{Binding RunButtonTip}">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource OP_Primary}" TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StopShown}" Value="True">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="{StaticResource OP_Unsafe}" />
                                                <Setter Property="Foreground" Value="{StaticResource OP_Unsafe}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <WrapPanel VerticalAlignment="Center">
                            <Border Margin="0,2,8,2" Padding="10,2" VerticalAlignment="Center" BorderBrush="{Binding PillBrush}" BorderThickness="1" CornerRadius="11">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding PillBrush}" />
                                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{Binding PillBrush}" Text="{Binding PillText}" />
                                </StackPanel>
                            </Border>
                            <!--  when the stage line does not fit: only the stage running now, next to the state  -->
                            <Border Style="{StaticResource OP_StageChip}" Tag="True" ToolTip="Current stage">
                                <Border.Visibility>
                                    <MultiBinding Converter="{StaticResource OP_AllVisible}" ConverterParameter="1">
                                        <Binding Path="CurrentStageText" />
                                        <Binding ElementName="stageLine" Path="ChosenIndex" />
                                    </MultiBinding>
                                </Border.Visibility>
                                <TextBlock Style="{StaticResource OP_StageChipText}" Text="{Binding CurrentStageText}" />
                            </Border>
                        </WrapPanel>
                    </DockPanel>

                    <!--  line 2: the stages, while they fit on one line  -->
                    <local:FirstFitPanel x:Name="stageLine" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource OP_StageChip}" Tag="{Binding StepWait}" Visibility="{Binding WithSafety, Converter={StaticResource OP_BoolVisible}}">
                                <TextBlock Style="{StaticResource OP_StageChipText}" Text="Waiting for safe" />
                            </Border>
                            <Border Style="{StaticResource OP_StageChip}" Tag="{Binding StepBegin}">
                                <TextBlock Style="{StaticResource OP_StageChipText}" Text="1 Begin" />
                            </Border>
                            <Border Style="{StaticResource OP_StageChip}" Tag="{Binding StepTarget}">
                                <TextBlock Style="{StaticResource OP_StageChipText}" Text="2 Start of target" />
                            </Border>
                            <Border Style="{StaticResource OP_StageChip}" Tag="{Binding StepImaging}">
                                <TextBlock Style="{StaticResource OP_StageChipText}" Text="Imaging + 3 triggers" />
                            </Border>
                            <Border Style="{StaticResource OP_StageChip}" Tag="{Binding StepEnd}">
                                <TextBlock Style="{StaticResource OP_StageChipText}" Text="4 End" />
                            </Border>
                            <TextBlock Margin="0,0,0,1" VerticalAlignment="Center" FontSize="16" Foreground="{StaticResource OP_Accent}" Text="↺" ToolTip="Repeats" Visibility="{Binding WithSafety, Converter={StaticResource OP_BoolVisible}}" />
                        </StackPanel>
                        <Border Height="0" />
                    </local:FirstFitPanel>

                    <!--  line 3: what is happening; a red ⚠ jumps to a warning on the tab shown  -->
                    <Border Margin="0,6,0,0" Padding="0,8,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <Button Margin="0,0,6,0" Padding="2,0" VerticalAlignment="Top" Click="JumpToWarning_Click" Content="⚠" FontSize="14" Foreground="{StaticResource OP_Unsafe}" Style="{StaticResource OP_Flat}" ToolTip="Show the warning" Visibility="{Binding TabHasWarnings, Converter={StaticResource OP_BoolVisible}}" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>

                    <!--  4 End steps that failed the last time it ran  -->
                    <Border Style="{StaticResource OP_WarnBox}" Visibility="{Binding EndProblems, Converter={StaticResource OP_TextVisible}}">
                        <DockPanel>
                            <Button Margin="8,0,0,0" Padding="2,0" VerticalAlignment="Top" Command="{Binding DismissEndProblemsCommand}" Content="✕" DockPanel.Dock="Right" Style="{StaticResource OP_Flat}" ToolTip="Close this message" />
                            <TextBlock Style="{StaticResource OP_WarnText}" Text="{Binding EndProblems, StringFormat=⚠ {0}}" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!--  ===== tabs; the gear and the ! at the right end open Options and Info =====  -->
            <Grid Grid.Row="1">
                <TabControl x:Name="plannerTabs" SelectedIndex="{Binding SelectedPlannerTab}">
                    <!-- =================== TARGETS =================== -->
                    <TabItem Header="Targets">
                        <ScrollViewer Margin="0,8,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!--  file bar: the four buttons while they fit next to the name, otherwise the Target Actions menu  -->
                                <Border Margin="0,0,0,10" Padding="12,8" Style="{StaticResource OP_Box}">
                                    <local:FirstFitPanel>
                                        <DockPanel>
                                            <StackPanel Margin="16,0,0,0" DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Command="{Binding NewListCommand}" Content="New" Style="{StaticResource OP_Small}" ToolTip="Saves this list, then starts an empty one" />
                                                <Button Command="{Binding OpenListCommand}" Content="Open…" Style="{StaticResource OP_Small}" ToolTip="Open a saved target list" />
                                                <Button Command="{Binding SaveListCommand}" Content="Save" Style="{StaticResource OP_Small}" ToolTip="Save this list" />
                                                <Button Margin="0" Command="{Binding SaveListAsCommand}" Content="Save as…" Style="{StaticResource OP_Small}" ToolTip="Save a copy under a new name" />
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                <TextBlock Margin="0,0,10,0" Style="{StaticResource OP_Label}" Text="TARGET LIST" />
                                                <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{Binding ListName}" />
                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{Binding ListSavedBrush}" Text="{Binding ListSavedIcon}" ToolTip="{Binding ListSavedText}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel>
                                            <Button Margin="12,0,0,0" Click="AddButton_Click" Content="Target Actions ▾" DockPanel.Dock="Right" Style="{StaticResource OP_Small}" ToolTip="Start a new target list, open a saved one, or save this one">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Command="{Binding NewListCommand}" Header="New" ToolTip="Saves this list, then starts an empty one" />
                                                        <MenuItem Command="{Binding OpenListCommand}" Header="Open…" ToolTip="Open a saved target list" />
                                                        <MenuItem Command="{Binding SaveListCommand}" Header="Save" ToolTip="Save this list" />
                                                        <MenuItem Command="{Binding SaveListAsCommand}" Header="Save as…" ToolTip="Save a copy under a new name" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                            <TextBlock Margin="0,0,10,0" DockPanel.Dock="Left" Style="{StaticResource OP_Label}" Text="TARGET LIST" />
                                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Right" Foreground="{Binding ListSavedBrush}" Text="{Binding ListSavedIcon}" ToolTip="{Binding ListSavedText}" />
                                            <TextBlock local:TrimTip.Enabled="True" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{Binding ListName}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </local:FirstFitPanel>
                                </Border>

                                <!--  the list and the selected target: side by side when both fit (same height), otherwise the list on top  -->
                                <local:SideBySidePanel DetailsMinWidth="430" ListWidth="270">
                                    <!--  target list  -->
                                    <Border Style="{StaticResource OP_Box}">
                                        <DockPanel>
                                            <TextBlock Margin="0,0,0,8" DockPanel.Dock="Top" Style="{StaticResource OP_Heading}" Text="TARGETS" />
                                            <WrapPanel Margin="0,10,0,0" DockPanel.Dock="Bottom">
                                                <Button Click="AddButton_Click" ToolTip="Add target">
                                                    <Button.Style>
                                                        <Style BasedOn="{StaticResource OP_Icon}" TargetType="Button">
                                                            <Setter Property="Background" Value="{StaticResource OP_Accent}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource OP_Accent}" />
                                                            <Setter Property="Foreground" Value="{StaticResource OP_AccentInk}" />
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="M12,5 V19 M5,12 H19" Style="{StaticResource OP_IconPath}" />
                                                        <Path Width="9" Height="9" Margin="2,0,0,0" Data="M2,3.5 L5,6.5 L8,3.5" Style="{StaticResource OP_IconPath}" />
                                                    </StackPanel>
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Command="{Binding AddEmptyCommand}" Header="Empty target" ToolTip="Opens Target Settings to enter its name and coordinates" />
                                                            <MenuItem Command="{Binding AddFromFramingCommand}" Header="From Framing Assistant" ToolTip="Name, coordinates and rotation of the framed target" />
                                                            <MenuItem Command="{Binding AddMosaicCommand}" Header="Mosaic from Framing Assistant" ToolTip="One target per mosaic panel" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                                <Button Command="{Binding DuplicateCommand}" Style="{StaticResource OP_Icon}" ToolTip="Duplicate target">
                                                    <Path Data="M10,8 H18 A2,2 0 0 1 20,10 V18 A2,2 0 0 1 18,20 H10 A2,2 0 0 1 8,18 V10 A2,2 0 0 1 10,8 Z M16,8 V6 A2,2 0 0 0 14,4 H6 A2,2 0 0 0 4,6 V14 A2,2 0 0 0 6,16 H8" Style="{StaticResource OP_IconPath}" />
                                                </Button>
                                                <Button Command="{Binding MoveUpCommand}" Style="{StaticResource OP_Icon}" ToolTip="Move up (image earlier)">
                                                    <Path Data="M12,19 V5 M6,11 L12,5 L18,11" Style="{StaticResource OP_IconPath}" />
                                                </Button>
                                                <Button Command="{Binding MoveDownCommand}" Style="{StaticResource OP_Icon}" ToolTip="Move down (image later)">
                                                    <Path Data="M12,5 V19 M6,13 L12,19 L18,13" Style="{StaticResource OP_IconPath}" />
                                                </Button>
                                                <Rectangle Width="1" Height="22" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource BorderBrush}" />
                                                <Button Command="{Binding DeleteCommand}" Style="{StaticResource OP_Icon}" ToolTip="Delete target">
                                                    <Path Data="M4,7 H20 M9,7 V4 H15 V7 M6,7 L7,20 H17 L18,7 M10,11 V17 M14,11 V17" Style="{StaticResource OP_IconPath}" />
                                                </Button>
                                            </WrapPanel>
                                            <!--  four rows, then it scrolls; beside the details it fills their height  -->
                                            <local:CappedScroller MaxItems="4">
                                                <ListBox
                                                    local:WheelBubbling.AtEnds="True"
                                                    AlternationCount="1000"
                                                    HorizontalContentAlignment="Stretch"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    ItemsSource="{Binding Targets}"
                                                    ScrollViewer.CanContentScroll="False"
                                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                    SelectedItem="{Binding SelectedTarget}"
                                                    VirtualizingPanel.IsVirtualizing="False">
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem">
                                                            <Setter Property="Margin" Value="0,0,0,4" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ListBoxItem">
                                                                        <Border x:Name="bd" Padding="8,6" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6">
                                                                            <ContentPresenter />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource TertiaryBackgroundBrush}" />
                                                                            </Trigger>
                                                                            <Trigger Property="IsSelected" Value="True">
                                                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource TertiaryBackgroundBrush}" />
                                                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource OP_Accent}" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="20" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <CheckBox Margin="0,0,8,0" IsChecked="{Binding Enabled}" Style="{StaticResource OP_Check}" ToolTip="Include this target" />
                                                                <TextBlock Grid.Column="1" MinWidth="14" Margin="0,0,4,0" VerticalAlignment="Center" FontSize="12" Opacity="0.6" Style="{StaticResource OP_Mono}" Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource OP_PlusOne}}" TextAlignment="Right" />
                                                                <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13">
                                                                    <TextBlock.Text>
                                                                        <MultiBinding Converter="{StaticResource OP_TargetState}">
                                                                            <Binding />
                                                                            <Binding Path="DataContext.ListState" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                                                            <Binding Path="Enabled" />
                                                                            <Binding Path="IsComplete" />
                                                                            <Binding Path="TotalFrames" />
                                                                        </MultiBinding>
                                                                    </TextBlock.Text>
                                                                    <TextBlock.Foreground>
                                                                        <MultiBinding Converter="{StaticResource OP_TargetState}" ConverterParameter="brush">
                                                                            <Binding />
                                                                            <Binding Path="DataContext.ListState" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                                                            <Binding Path="Enabled" />
                                                                            <Binding Path="IsComplete" />
                                                                            <Binding Path="TotalFrames" />
                                                                        </MultiBinding>
                                                                    </TextBlock.Foreground>
                                                                    <TextBlock.ToolTip>
                                                                        <MultiBinding Converter="{StaticResource OP_TargetState}" ConverterParameter="tip">
                                                                            <Binding />
                                                                            <Binding Path="DataContext.ListState" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                                                            <Binding Path="Enabled" />
                                                                            <Binding Path="IsComplete" />
                                                                            <Binding Path="TotalFrames" />
                                                                        </MultiBinding>
                                                                    </TextBlock.ToolTip>
                                                                </TextBlock>
                                                                <TextBlock Grid.Column="3" Margin="6,0" local:TrimTip.Enabled="True" VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="12" Opacity="0.7" Style="{StaticResource OP_Mono}" Text="{Binding Percent, StringFormat={}{0:0}%}" />
                                                                <Button Grid.Column="5" Margin="6,0,0,0" Command="{Binding DataContext.TargetSettingsCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Content="⚙" FontSize="15" Style="{StaticResource OP_Flat}" ToolTip="Target settings" />
                                                                <ProgressBar Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3" Height="3" Margin="6,4,0,0" Maximum="100" Value="{Binding Percent, Mode=OneWay}">
                                                                    <ProgressBar.Style>
                                                                        <Style TargetType="ProgressBar">
                                                                            <Setter Property="Foreground" Value="{StaticResource OP_Accent}" />
                                                                            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
                                                                            <Setter Property="BorderThickness" Value="0" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource OP_Safe}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ProgressBar.Style>
                                                                </ProgressBar>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </local:CappedScroller>
                                        </DockPanel>
                                    </Border>

                                    <!--  selected target  -->
                                    <Border x:Name="detailsBox" Style="{StaticResource OP_Box}">
                                        <Grid>
                                            <TextBlock Opacity="0.7" Text="Add a target to get started." Visibility="{Binding HasSelection, Converter={StaticResource OP_BoolCollapsed}}" />
                                            <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource OP_BoolVisible}}">
                                                <!--  header: the buttons show their words when the pane is wide enough, otherwise only the icon  -->
                                                <DockPanel Margin="0,0,0,10" DockPanel.Dock="Top">
                                                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Top" DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button Command="{Binding AutofocusCommand}" Style="{StaticResource OP_Small}" ToolTip="Run autofocus before the next frame. The frame being taken now finishes first. Available while a target is imaging.">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" Text="◎" />
                                                                <TextBlock Margin="6,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" Text="{Binding AutofocusWord}" Visibility="{Binding ActualWidth, ElementName=detailsBox, Converter={StaticResource OP_AtLeast}, ConverterParameter=470}" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Margin="0" Command="{Binding TargetSettingsCommand}" CommandParameter="{Binding SelectedTarget}" Style="{StaticResource OP_Small}" ToolTip="Target settings">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" Text="⚙" />
                                                                <TextBlock Margin="6,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" Text="Target settings" Visibility="{Binding ActualWidth, ElementName=detailsBox, Converter={StaticResource OP_AtLeast}, ConverterParameter=470}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock local:TrimTip.Enabled="True" FontSize="21" FontWeight="Bold" Text="{Binding SelectedTarget.Name}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,2,0,4" FontSize="12.5" Opacity="0.7" Style="{StaticResource OP_Mono}" Text="{Binding CoordinatesText}" TextWrapping="Wrap" />
                                                        <ItemsControl ItemsSource="{Binding TargetChips}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Style="{StaticResource OP_Chip}">
                                                                        <TextBlock FontSize="12" Text="{Binding}" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DockPanel>

                                                <!--  delay and order  -->
                                                <WrapPanel Margin="0,0,0,4" DockPanel.Dock="Top">
                                                    <TextBlock Style="{StaticResource OP_Strong}" Text="DELAY:" />
                                                    <StackPanel Margin="0,2,16,2" Orientation="Horizontal" ToolTip="Wait before the first exposure each time this target starts or resumes, e.g. to let the mount settle after centering.">
                                                        <TextBlock VerticalAlignment="Center" Opacity="0.75" Text="⧗ Delay first " />
                                                        <TextBox Width="52" Text="{Binding SelectedTarget.DelayFirst}" />
                                                        <TextBlock VerticalAlignment="Center" Text=" s" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,2" Orientation="Horizontal" ToolTip="Wait between each exposure.">
                                                        <TextBlock VerticalAlignment="Center" Opacity="0.75" Text="⧗ Delay between " />
                                                        <TextBox Width="52" Text="{Binding SelectedTarget.DelayBetween}" />
                                                        <TextBlock VerticalAlignment="Center" Text=" s" />
                                                    </StackPanel>
                                                </WrapPanel>
                                                <WrapPanel Margin="0,0,0,8" DockPanel.Dock="Top" ToolTip="Rotate takes one frame per row in turn (Ha, OIII, SII, Ha…). Finish completes each row before moving to the next.">
                                                    <TextBlock Style="{StaticResource OP_Strong}" Text="ORDER:" />
                                                    <RadioButton Content="Rotate through filters" GroupName="OP_TargetOrder" IsChecked="{Binding SelectedTarget.Order, Converter={StaticResource OP_EnumBool}, ConverterParameter=RotateThroughFilters}" Style="{StaticResource OP_Radio}" />
                                                    <RadioButton Content="Finish each row first" GroupName="OP_TargetOrder" IsChecked="{Binding SelectedTarget.Order, Converter={StaticResource OP_EnumBool}, ConverterParameter=FinishEachRowFirst}" Style="{StaticResource OP_Radio}" />
                                                </WrapPanel>

                                                <!--  footer  -->
                                                <StackPanel Margin="0,8,0,0" DockPanel.Dock="Bottom">
                                                    <WrapPanel>
                                                        <Button Margin="0,2,6,2" Command="{Binding AddExposureCommand}" Content="＋ Add exposure" Style="{StaticResource OP_Small}" />
                                                        <Button Margin="0,2,6,2" Command="{Binding ResetProgressCommand}" Content="Reset progress" Style="{StaticResource OP_Small}" />
                                                        <TextBlock Margin="0,2,6,2" VerticalAlignment="Center" Opacity="0.7" Text="{Binding RemainingText}" />
                                                    </WrapPanel>
                                                    <Border Style="{StaticResource OP_WarnBox}" Tag="OP_Warn" Visibility="{Binding RotateAfWarning, Converter={StaticResource OP_TextVisible}}">
                                                        <DockPanel>
                                                            <Button Margin="8,0,0,0" Padding="2,0" VerticalAlignment="Top" Command="{Binding DismissWarningCommand}" CommandParameter="{Binding RotateAfWarning}" Content="✕" DockPanel.Dock="Right" Style="{StaticResource OP_Flat}" ToolTip="Close this message" />
                                                            <TextBlock Style="{StaticResource OP_WarnText}" Text="{Binding RotateAfWarning, StringFormat=⚠ {0}}" />
                                                        </DockPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource OP_WarnBox}" Tag="OP_Warn" Visibility="{Binding ManualFilterWarning, Converter={StaticResource OP_TextVisible}}">
                                                        <DockPanel>
                                                            <Button Margin="8,0,0,0" Padding="2,0" VerticalAlignment="Top" Command="{Binding DismissWarningCommand}" CommandParameter="{Binding ManualFilterWarning}" Content="✕" DockPanel.Dock="Right" Style="{StaticResource OP_Flat}" ToolTip="Close this message" />
                                                            <TextBlock Style="{StaticResource OP_WarnText}" Text="{Binding ManualFilterWarning, StringFormat=⚠ {0}}" />
                                                        </DockPanel>
                                                    </Border>
                                                </StackPanel>

                                                <!--  exposure rows: one line while they fit, otherwise they wrap; four rows, then they scroll  -->
                                                <Border local:ExposureRowPanel.FilterChars="{Binding FilterColumnChars}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                                    <DockPanel>
                                                        <Border Padding="8,5" Background="{DynamicResource TertiaryBackgroundBrush}" CornerRadius="4,4,0,0" DockPanel.Dock="Top">
                                                            <local:ExposureRowPanel IsHeader="True" Margin="{Binding ComputedVerticalScrollBarVisibility, ElementName=exposureScroll, Converter={StaticResource OP_ScrollBarMargin}}">
                                                                <local:FirstFitPanel>
                                                                    <TextBlock Style="{StaticResource OP_ColumnHead}" Text="Priority" />
                                                                    <TextBlock Style="{StaticResource OP_ColumnHead}" Text="#" />
                                                                </local:FirstFitPanel>
                                                                <TextBlock Style="{StaticResource OP_ColumnHead}" Text="Run" />
                                                                <TextBlock Style="{StaticResource OP_ColumnHead}" Text="Type" />
                                                                <TextBlock Style="{StaticResource OP_ColumnHead}" Text="Filter" />
                                                                <local:FirstFitPanel>
                                                                    <TextBlock Style="{StaticResource OP_ColumnHead}" Text="Exposure (s)" />
                                                                    <TextBlock Style="{StaticResource OP_ColumnHead}" Text="Exp s" />
                                                                </local:FirstFitPanel>
                                                                <local:FirstFitPanel>
                                                                    <TextBlock Style="{StaticResource OP_ColumnHead}" Text="Binning" />
                                                                    <TextBlock Style="{StaticResource OP_ColumnHead}" Text="Bin" />
                                                                </local:FirstFitPanel>
                                                                <TextBlock Style="{StaticResource OP_ColumnHead}" Text="Repeat" />
                                                                <TextBlock Style="{StaticResource OP_ColumnHead}" Text="Progress" />
                                                                <Border />
                                                            </local:ExposureRowPanel>
                                                        </Border>
                                                        <local:CappedScroller MaxItems="4">
                                                            <ScrollViewer x:Name="exposureScroll" local:WheelBubbling.AtEnds="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                                <ItemsControl AlternationCount="1000" ItemsSource="{Binding SelectedTarget.Exposures}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Padding="8,5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                                                                                <local:ExposureRowPanel>
                                                                                    <!--  priority: ▶ on the row being imaged, the number, ▲ ▼  -->
                                                                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                                                                                        <TextBlock Width="10" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource OP_Accent}" Text="▶" ToolTip="Being imaged now">
                                                                                            <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock">
                                                                                                    <Setter Property="Visibility" Value="Hidden" />
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </TextBlock.Style>
                                                                                        </TextBlock>
                                                                                        <TextBlock Width="16" Margin="0,0,3,0" VerticalAlignment="Center" Opacity="0.7" Style="{StaticResource OP_Mono}" Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource OP_PlusOne}}" TextAlignment="Right" />
                                                                                        <Button Padding="2,0" Command="{Binding DataContext.ExposureUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Content="▲" FontSize="9" Style="{StaticResource OP_Flat}" ToolTip="Move up (higher priority)" />
                                                                                        <Button Padding="2,0" Command="{Binding DataContext.ExposureDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Content="▼" FontSize="9" Style="{StaticResource OP_Flat}" ToolTip="Move down (lower priority)" />
                                                                                    </StackPanel>
                                                                                    <CheckBox HorizontalAlignment="Left" IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OP_Check}" ToolTip="Run this row" />
                                                                                    <ComboBox DisplayMemberPath="Label" ItemsSource="{Binding DataContext.ExposureTypeChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}" SelectedValue="{Binding Type}" SelectedValuePath="Value" ToolTip="Image type. The camera's gain is used." />
                                                                                    <Grid>
                                                                                        <ComboBox IsEditable="True" ItemsSource="{Binding DataContext.FilterChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Text="{Binding Filter, UpdateSourceTrigger=LostFocus}" ToolTip="Filter (from the filter wheel in your NINA profile)" Visibility="{Binding DataContext.HasFilterWheel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource OP_BoolVisible}}" />
                                                                                        <!--  no filter wheel in the NINA profile (a colour camera): no filter is changed  -->
                                                                                        <TextBlock Margin="6,0" VerticalAlignment="Center" Opacity="0.6" Text="—" ToolTip="No filter wheel in the NINA profile (e.g. a colour camera): no filter is changed" Visibility="{Binding DataContext.HasFilterWheel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource OP_BoolCollapsed}}" />
                                                                                    </Grid>
                                                                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal" ToolTip="Exposure time in seconds">
                                                                                        <TextBox Width="52" Text="{Binding ExposureTime, UpdateSourceTrigger=LostFocus}" />
                                                                                        <StackPanel Margin="2,0,0,0" VerticalAlignment="Center">
                                                                                            <RepeatButton Margin="0,0,0,1" Click="Step_Click" Content="▲" Style="{StaticResource OP_Spin}" Tag="exposure|1" ToolTip="Increase" />
                                                                                            <RepeatButton Click="Step_Click" Content="▼" Style="{StaticResource OP_Spin}" Tag="exposure|-1" ToolTip="Decrease" />
                                                                                        </StackPanel>
                                                                                    </StackPanel>
                                                                                    <ComboBox ItemsSource="{Binding DataContext.BinningChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}" SelectedItem="{Binding Binning}" ToolTip="Binning" />
                                                                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal" ToolTip="How many frames of this row to take">
                                                                                        <TextBox Width="52" Text="{Binding Count, UpdateSourceTrigger=LostFocus}" />
                                                                                        <StackPanel Margin="2,0,0,0" VerticalAlignment="Center">
                                                                                            <RepeatButton Margin="0,0,0,1" Click="Step_Click" Content="▲" Style="{StaticResource OP_Spin}" Tag="repeat|1" ToolTip="Increase" />
                                                                                            <RepeatButton Click="Step_Click" Content="▼" Style="{StaticResource OP_Spin}" Tag="repeat|-1" ToolTip="Decrease" />
                                                                                        </StackPanel>
                                                                                    </StackPanel>
                                                                                    <!--  progress: click to change the captured frames  -->
                                                                                    <Grid VerticalAlignment="Center">
                                                                                        <ToggleButton x:Name="progressButton" Padding="0,2" HorizontalContentAlignment="Stretch" Style="{StaticResource OP_Flat}" ToolTip="Click to change the captured frames">
                                                                                            <Grid>
                                                                                                <Grid.ColumnDefinitions>
                                                                                                    <ColumnDefinition Width="*" />
                                                                                                    <ColumnDefinition Width="Auto" />
                                                                                                </Grid.ColumnDefinitions>
                                                                                                <ProgressBar Maximum="{Binding Count, Mode=OneWay}" Style="{StaticResource OP_RowProgress}" Value="{Binding Done, Mode=OneWay}" />
                                                                                                <TextBlock Grid.Column="1" Style="{StaticResource OP_RowProgressText}">
                                                                                                    <Run Text="{Binding Done, Mode=OneWay}" /><Run Text="/" /><Run Text="{Binding Count, Mode=OneWay}" />
                                                                                                </TextBlock>
                                                                                            </Grid>
                                                                                        </ToggleButton>
                                                                                        <Popup AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=progressButton}" Placement="Bottom" PlacementTarget="{Binding ElementName=progressButton}" StaysOpen="False">
                                                                                            <Border Padding="10,8" Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource OP_Accent}" BorderThickness="1" CornerRadius="6">
                                                                                                <StackPanel Orientation="Horizontal">
                                                                                                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Captured frames:" />
                                                                                                    <TextBox Width="60" Text="{Binding Done, UpdateSourceTrigger=PropertyChanged}" />
                                                                                                    <StackPanel Margin="2,0,0,0" VerticalAlignment="Center">
                                                                                                        <RepeatButton Margin="0,0,0,1" Click="Step_Click" Content="▲" Style="{StaticResource OP_Spin}" Tag="done|1" ToolTip="Increase" />
                                                                                                        <RepeatButton Click="Step_Click" Content="▼" Style="{StaticResource OP_Spin}" Tag="done|-1" ToolTip="Decrease" />
                                                                                                    </StackPanel>
                                                                                                    <Button Margin="8,0,0,0" Click="ProgressOk_Click" Content="OK" Style="{StaticResource OP_Primary}" />
                                                                                                </StackPanel>
                                                                                            </Border>
                                                                                        </Popup>
                                                                                    </Grid>
                                                                                    <Button HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding DataContext.DeleteExposureCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Content="✕" Style="{StaticResource OP_Flat}" ToolTip="Delete row" />
                                                                                </local:ExposureRowPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>
                                                        </local:CappedScroller>
                                                    </DockPanel>
                                                </Border>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </local:SideBySidePanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- =================== SEQUENCE (the four stages) =================== -->
                    <TabItem Header="Sequence">
                        <ScrollViewer Margin="0,8,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!--  file bar: Refresh and the three buttons while they fit, then Sequence Actions, then Refresh as an icon  -->
                                <Border Margin="0,0,0,10" Padding="12,8" Style="{StaticResource OP_Box}">
                                    <local:FirstFitPanel>
                                        <DockPanel>
                                            <StackPanel Margin="16,0,0,0" DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Command="{Binding RefreshStagesCommand}" Content="↻ Refresh" Style="{StaticResource OP_Small}" ToolTip="Refresh: read the four stages again from the Advanced Sequencer (it also happens every few seconds)" />
                                                <Button Command="{Binding OpenWorkflowCommand}" Content="Open…" Style="{StaticResource OP_Small}" ToolTip="Open a saved workflow" />
                                                <Button Command="{Binding SaveWorkflowCommand}" Content="Save" Style="{StaticResource OP_Small}" ToolTip="Save this workflow" />
                                                <Button Margin="0" Command="{Binding SaveWorkflowAsCommand}" Content="Save as…" Style="{StaticResource OP_Small}" ToolTip="Save a copy under a new name" />
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                <TextBlock Margin="0,0,10,0" Style="{StaticResource OP_Label}" Text="SEQUENCE" />
                                                <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{Binding WorkflowName}" />
                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{Binding WorkflowSavedBrush}" Text="{Binding WorkflowSavedIcon}" ToolTip="{Binding WorkflowSavedText}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel>
                                            <StackPanel Margin="12,0,0,0" DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Command="{Binding RefreshStagesCommand}" Content="↻ Refresh" Style="{StaticResource OP_Small}" ToolTip="Refresh: read the four stages again from the Advanced Sequencer (it also happens every few seconds)" />
                                                <Button Margin="0" Click="AddButton_Click" Content="Sequence Actions ▾" Style="{StaticResource OP_Small}" ToolTip="Open a saved workflow, or save this one">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Command="{Binding OpenWorkflowCommand}" Header="Open…" ToolTip="Open a saved workflow" />
                                                            <MenuItem Command="{Binding SaveWorkflowCommand}" Header="Save" ToolTip="Save this workflow" />
                                                            <MenuItem Command="{Binding SaveWorkflowAsCommand}" Header="Save as…" ToolTip="Save a copy under a new name" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                <TextBlock Margin="0,0,10,0" Style="{StaticResource OP_Label}" Text="SEQUENCE" />
                                                <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{Binding WorkflowName}" />
                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{Binding WorkflowSavedBrush}" Text="{Binding WorkflowSavedIcon}" ToolTip="{Binding WorkflowSavedText}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel>
                                            <StackPanel Margin="8,0,0,0" DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Command="{Binding RefreshStagesCommand}" Content="↻" Style="{StaticResource OP_Small}" ToolTip="Refresh: read the four stages again from the Advanced Sequencer (it also happens every few seconds)" />
                                                <Button Margin="0" Click="AddButton_Click" Content="Sequence Actions ▾" Style="{StaticResource OP_Small}" ToolTip="Open a saved workflow, or save this one">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Command="{Binding OpenWorkflowCommand}" Header="Open…" ToolTip="Open a saved workflow" />
                                                            <MenuItem Command="{Binding SaveWorkflowCommand}" Header="Save" ToolTip="Save this workflow" />
                                                            <MenuItem Command="{Binding SaveWorkflowAsCommand}" Header="Save as…" ToolTip="Save a copy under a new name" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock Margin="0,0,10,0" DockPanel.Dock="Left" Style="{StaticResource OP_Label}" Text="SEQUENCE" />
                                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Right" Foreground="{Binding WorkflowSavedBrush}" Text="{Binding WorkflowSavedIcon}" ToolTip="{Binding WorkflowSavedText}" />
                                            <TextBlock local:TrimTip.Enabled="True" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{Binding WorkflowName}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </local:FirstFitPanel>
                                </Border>

                                <!--  the four stages: one column in a narrow dock, more when it is wide; each can be collapsed  -->
                                <ItemsControl ItemsSource="{Binding Stages}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <local:AutoColumnsPanel ColumnGap="10" MaxColumns="2" MinColumnWidth="330" RowGap="0" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Top">
                                                <Expander Style="{StaticResource OP_Section}">
                                                    <Expander.Header>
                                                        <DockPanel>
                                                            <!--  collapsed: the edit button moves into the heading  -->
                                                            <Button Margin="8,0,0,0" Padding="6,0" Command="{Binding DataContext.EditInSequencerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Content="✎" DockPanel.Dock="Right" Style="{StaticResource OP_Small}" ToolTip="Edit in Advanced Sequencer" Visibility="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}, Converter={StaticResource OP_BoolCollapsed}}" />
                                                            <Border Width="22" Height="22" Margin="0,0,8,0" Background="{Binding Brush}" CornerRadius="11" DockPanel.Dock="Left">
                                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource OP_AccentInk}" Text="{Binding Number}" />
                                                            </Border>
                                                            <WrapPanel VerticalAlignment="Center">
                                                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource OP_Heading}" Text="{Binding Title}" TextWrapping="Wrap" />
                                                                <TextBlock VerticalAlignment="Center" FontSize="12" Opacity="0.6" Text="{Binding CountText}" />
                                                            </WrapPanel>
                                                        </DockPanel>
                                                    </Expander.Header>
                                                    <StackPanel>
                                                        <TextBlock Margin="0,0,0,8" Style="{StaticResource OP_Hint}" Text="{Binding Hint}" />
                                                        <Grid>
                                                            <TextBlock Opacity="0.7" Text="{Binding EmptyText}" TextWrapping="Wrap" Visibility="{Binding EmptyText, Converter={StaticResource OP_TextVisible}}" />
                                                            <ScrollViewer MaxHeight="230" local:WheelBubbling.AtEnds="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                                <ItemsControl ItemsSource="{Binding Lines}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Padding="0,3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="22" />
                                                                                        <ColumnDefinition Width="92" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock FontSize="11" Opacity="0.6" Style="{StaticResource OP_Mono}" Text="{Binding Number}" />
                                                                                    <TextBlock Grid.Column="1" Margin="0,0,8,0" local:TrimTip.Enabled="True" FontSize="11" Opacity="0.6" Style="{StaticResource OP_Mono}" Text="{Binding Category}" TextTrimming="CharacterEllipsis" />
                                                                                    <TextBlock Grid.Column="2" FontSize="13" TextWrapping="Wrap">
                                                                                        <Run Text="{Binding Name, Mode=OneWay}" /><Run Foreground="{StaticResource OP_Muted}" Text="{Binding SummaryText, Mode=OneWay}" />
                                                                                    </TextBlock>
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>
                                                        </Grid>
                                                        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Warnings}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Style="{StaticResource OP_WarnBox}" Tag="OP_Warn">
                                                                        <DockPanel>
                                                                            <Button Margin="8,0,0,0" Padding="2,0" VerticalAlignment="Top" Command="{Binding DataContext.DismissWarningCommand, RelativeSource={RelativeSource AncestorType=TabControl}}" CommandParameter="{Binding}" Content="✕" DockPanel.Dock="Right" Style="{StaticResource OP_Flat}" ToolTip="Close this message" />
                                                                            <TextBlock Style="{StaticResource OP_WarnText}" Text="{Binding StringFormat=⚠ {0}}" />
                                                                        </DockPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Button Margin="0,8,0,0" HorizontalAlignment="Left" Command="{Binding DataContext.EditInSequencerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Content="✎  Edit in Advanced Sequencer" Style="{StaticResource OP_Small}" />
                                                    </StackPanel>
                                                </Expander>
                                                <!--  the stage's colour along the top  -->
                                                <Border Height="3" VerticalAlignment="Top" Background="{Binding Brush}" CornerRadius="6,6,0,0" IsHitTestVisible="False" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- =================== OPTIONS (opened with the gear) =================== -->
                    <TabItem Header="Options" Visibility="Collapsed">
                        <ScrollViewer Margin="0,8,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="760" HorizontalAlignment="Stretch">
                                <Expander Style="{StaticResource OP_Section}">
                                    <Expander.Header>
                                        <TextBlock Style="{StaticResource OP_Heading}" Text="RUN MODE" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <local:AutoColumnsPanel ColumnGap="8" MaxColumns="2" MinColumnWidth="220" RowGap="8">
                                            <RadioButton Margin="0" GroupName="OP_Mode" IsChecked="{Binding WithSafety, Mode=TwoWay}" Style="{StaticResource OP_Card}">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="Run with safety" />
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource OP_Hint}" Text="You have a safety monitor. Runs every night: starts when it is safe, shuts down when unsafe, resumes when safe again." />
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton Margin="0" GroupName="OP_Mode" IsChecked="{Binding WithoutSafety, Mode=TwoWay}" Style="{StaticResource OP_Card}">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="Run without safety" />
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource OP_Hint}" Text="No safety monitor. Each Run goes through your targets once, then stops. Stay nearby for weather." />
                                                </StackPanel>
                                            </RadioButton>
                                        </local:AutoColumnsPanel>
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource OP_Hint}" Text="Pick the one that matches your setup; you normally set this once. Changing it offers to load the default workflow for that mode." />
                                        <CheckBox Margin="0,12,0,0" IsChecked="{Binding Options.AutoStartOnLaunch}" Style="{StaticResource OP_Check}">
                                            <TextBlock Text="Start the run when NINA starts (the last workflow and target list are reopened first)" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <TextBlock Margin="23,2,0,0" Style="{StaticResource OP_Hint}" Text="For unattended restarts, e.g. after a power cut or a Windows update. A sequence that was paused stays paused." />
                                        <StackPanel Margin="0,12,0,0" Visibility="{Binding WithSafety, Converter={StaticResource OP_BoolVisible}}">
                                            <WrapPanel>
                                                <TextBlock VerticalAlignment="Center" Text="When it becomes safe, wait " />
                                                <TextBox Width="60" Text="{Binding Options.SafeDelaySeconds}" />
                                                <TextBlock VerticalAlignment="Center" Text=" s before 1 Begin" />
                                            </WrapPanel>
                                            <TextBlock Margin="0,2,0,0" Style="{StaticResource OP_Hint}" Text="It must stay safe for the whole wait; if it turns unsafe, the wait starts again the next time it is safe. 0 starts at once." />
                                        </StackPanel>
                                        <CheckBox Margin="0,12,0,0" IsChecked="{Binding Options.AutofocusAfterBegin}" Style="{StaticResource OP_Check}">
                                            <TextBlock Text="Autofocus before the first frame after 1 Begin, and after a weather close-up" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <TextBlock Margin="23,2,0,0" Style="{StaticResource OP_Hint}" Text="1 Begin runs after the equipment was off (the start of the night, after clouds), so the focus is found again before the first light frame, once the target is centred and guiding. Filter changes are handled by &quot;AF after filter change (planner)&quot; in 3 While imaging." />
                                    </StackPanel>
                                </Expander>

                                <Expander Style="{StaticResource OP_Section}">
                                    <Expander.Header>
                                        <TextBlock Style="{StaticResource OP_Heading}" Text="WEATHER" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <WrapPanel>
                                            <CheckBox Margin="0,0,8,4" VerticalAlignment="Center" FontWeight="SemiBold" Content="Night: image only while the Sun is below" IsChecked="{Binding Options.NightLimitEnabled}" Style="{StaticResource OP_Check}" />
                                            <ComboBox Width="230" Margin="0,0,0,4" DisplayMemberPath="Label" IsEnabled="{Binding Options.NightLimitEnabled}" ItemsSource="{Binding SunLimitChoices}" SelectedValue="{Binding Options.NightLimit}" SelectedValuePath="Value" />
                                        </WrapPanel>
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource OP_Hint}" Text="This defines the night for choosing targets, and is what keeps the planner from imaging into daylight:" />
                                        <TextBlock Margin="10,2,0,0" Style="{StaticResource OP_Hint}" Text="• Evening: no target starts before the Sun is below the chosen twilight, even if the target's own start time or altitude has been reached." />
                                        <TextBlock Margin="10,2,0,0" Style="{StaticResource OP_Hint}" Text="• Morning: no frame starts that would end after the Sun rises above it. When no target can run any more, the night is finished and 4 End runs." />
                                        <TextBlock Margin="10,2,0,0" Style="{StaticResource OP_Hint}" Text="• It does not start 1 Begin: with a safety monitor 1 Begin starts when it reports safe; without one the built-in workflows wait for astronomical dusk (Wait for Time in 1 Begin)." />
                                        <TextBlock Margin="10,2,0,0" Style="{StaticResource OP_Hint}" Text="• Off: the Sun is not considered; targets are limited by their own start and end settings, the horizon and the safety monitor." />
                                        <StackPanel Margin="0,12,0,0" Visibility="{Binding WithSafety, Converter={StaticResource OP_BoolVisible}}">
                                            <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="When it turns unsafe during the night:" TextWrapping="Wrap" />
                                            <RadioButton GroupName="OP_Unsafe" IsChecked="{Binding Options.UnsafeAction, Converter={StaticResource OP_EnumBool}, ConverterParameter=RunEnd}" Style="{StaticResource OP_Radio}">
                                                <TextBlock Text="Run 4 End (full shutdown: warm the camera, power off)" TextWrapping="Wrap" />
                                            </RadioButton>
                                            <RadioButton GroupName="OP_Unsafe" IsChecked="{Binding Options.UnsafeAction, Converter={StaticResource OP_EnumBool}, ConverterParameter=CloseUpAndWait}" Style="{StaticResource OP_Radio}">
                                                <TextBlock Text="Close up and wait: stop guiding, park, close the dome; power, connections and camera cooling stay on" TextWrapping="Wrap" />
                                            </RadioButton>
                                            <StackPanel Margin="23,6,0,0" IsEnabled="{Binding CloseUpOnUnsafe}">
                                                <WrapPanel>
                                                    <TextBlock Margin="0,0,0,4" VerticalAlignment="Center" Text="Run 4 End if it is still unsafe after " />
                                                    <TextBox Width="52" Margin="0,0,0,4" Text="{Binding Options.CloseUpMaxHours}" />
                                                    <TextBlock Margin="0,0,0,4" VerticalAlignment="Center" Text=" h, or at " />
                                                    <ComboBox Width="230" Margin="0,0,0,4" DisplayMemberPath="Label" ItemsSource="{Binding SunLimitChoices}" SelectedValue="{Binding Options.CloseUpEnd}" SelectedValuePath="Value" />
                                                    <TextBlock Margin="0,0,0,4" VerticalAlignment="Center" Text=", whichever comes first" />
                                                </WrapPanel>
                                                <TextBlock Margin="0,6,0,0" Style="{StaticResource OP_Hint}" Text="The close-up also ends when nothing is left to image tonight. The morning time chosen here is separate from the Night setting above. When it is safe again (after the wait after safe): open the dome, unpark, autofocus before the first frame (with the autofocus option on), then 2 Start of target. Close-up starts once 1 Begin has finished; unsafe during 1 Begin runs 4 End. If park or closing the dome fails, 4 End runs at once. Stop while closed up runs 4 End." />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>

                                <Expander Style="{StaticResource OP_Section}">
                                    <Expander.Header>
                                        <TextBlock Style="{StaticResource OP_Heading}" Text="GUIDE STAR LOST" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding Options.GuideLostWatch}" Style="{StaticResource OP_Check}">
                                            <TextBlock Text="Watch the guide star during light frames (PHD2)" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <StackPanel Margin="23,6,0,0" IsEnabled="{Binding Options.GuideLostWatch}">
                                            <WrapPanel>
                                                <TextBlock VerticalAlignment="Center" Text="Wait up to " />
                                                <TextBox Width="60" Text="{Binding Options.GuideLostWaitSeconds}" />
                                                <TextBlock VerticalAlignment="Center" Text=" s for PHD2 to find the star again" />
                                            </WrapPanel>
                                            <TextBlock Margin="0,8,0,4" Text="If it doesn't come back:" />
                                            <RadioButton GroupName="OP_GuideLost" IsChecked="{Binding Options.GuideLostAction, Converter={StaticResource OP_EnumBool}, ConverterParameter=StopForNight}" Style="{StaticResource OP_Radio}">
                                                <TextBlock Text="Run 4 End and stop for the night" TextWrapping="Wrap" />
                                            </RadioButton>
                                            <RadioButton GroupName="OP_GuideLost" IsChecked="{Binding Options.GuideLostAction, Converter={StaticResource OP_EnumBool}, ConverterParameter=NextTarget}" Style="{StaticResource OP_Radio}">
                                                <TextBlock Text="Go to the next target (4 End runs if there is none)" TextWrapping="Wrap" />
                                            </RadioButton>
                                            <TextBlock Margin="0,6,0,0" Style="{StaticResource OP_Hint}" Text="A loss shorter than 10 s is ignored. A longer one drops the frame being taken (it is taken again). The wait counts from when the star was lost. Unsafe weather during the wait is handled as usual: 4 End, then wait for safe." />
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>

                                <Expander Style="{StaticResource OP_Section}">
                                    <Expander.Header>
                                        <TextBlock Style="{StaticResource OP_Heading}" Text="GUIDING ERROR" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding Options.GuidingCheck}" Style="{StaticResource OP_Check}">
                                            <TextBlock Text="Check the guiding error before and during light frames (PHD2)" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <StackPanel Margin="23,6,0,0" IsEnabled="{Binding Options.GuidingCheck}">
                                            <WrapPanel>
                                                <TextBlock VerticalAlignment="Center" Text="Limit " />
                                                <TextBox Width="60" Text="{Binding Options.GuidingLimitPixels}" />
                                                <TextBlock VerticalAlignment="Center" Text=" px (guide camera pixels)" />
                                            </WrapPanel>
                                            <TextBlock Margin="0,2,0,0" Style="{StaticResource OP_Hint}" Text="{Binding GuidingLimitArcsec}" />
                                            <WrapPanel Margin="0,8,0,0">
                                                <TextBlock VerticalAlignment="Center" Text="Before a frame, wait up to " />
                                                <TextBox Width="60" Text="{Binding Options.GuidingCheckWaitSeconds}" />
                                                <TextBlock VerticalAlignment="Center" Text=" s for the error to come below the limit, then start anyway" TextWrapping="Wrap" />
                                            </WrapPanel>
                                            <TextBlock Margin="0,6,0,0" Style="{StaticResource OP_Hint}" Text="The error is the total (RA and Dec) over the last 10 guide steps; dithers are not counted. A frame is restarted when the error stays above the limit for 10 s. A frame started because the wait ran out is not restarted." />
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>

                                <Expander Style="{StaticResource OP_Section}">
                                    <Expander.Header>
                                        <TextBlock Style="{StaticResource OP_Heading}" Text="MOUNT RECOVERY (GS SERVER)" TextWrapping="Wrap" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OP_Hint}" Text="Available when the mount in NINA is GS Server, with a mount that has home sensors (e.g. CQ-350 Pro)." Visibility="{Binding MountIsGss, Converter={StaticResource OP_BoolCollapsed}}" />
                                        <StackPanel IsEnabled="{Binding MountIsGss}">
                                            <CheckBox Margin="0,4,0,0" IsChecked="{Binding Options.MountRecovery}" Style="{StaticResource OP_Check}">
                                                <TextBlock Text="If GS Server stops during 1 Begin, 2 Start of target or imaging, recover the mount automatically" TextWrapping="Wrap" />
                                            </CheckBox>
                                            <WrapPanel Margin="23,4,0,0" IsEnabled="{Binding Options.MountRecovery}">
                                                <TextBlock VerticalAlignment="Center" Text="Try up to " />
                                                <TextBox Width="40" Text="{Binding Options.MountRecoveryTries}" />
                                                <TextBlock VerticalAlignment="Center" Text=" times, 10 s apart" />
                                            </WrapPanel>
                                            <TextBlock Margin="23,2,0,0" Style="{StaticResource OP_Hint}" Text="Reconnect the mount (this starts GS Server), AutoHome with the home sensors through GS Server's API, unpark, then continue: an interrupted 1 Begin from its next step, otherwise 2 Start of target. Not during 4 End. While paused, closed up or waiting it runs when the run continues, and only if the mount is not connected." />
                                            <TextBlock Margin="0,10,0,2" Text="If the recovery fails (the mount position is unknown):" TextWrapping="Wrap" />
                                            <CheckBox Margin="0,2,0,0" IsChecked="{Binding Options.CloseRoofWhenRecoveryFails}" Style="{StaticResource OP_Check}">
                                                <TextBlock Text="Close the dome/roof anyway when it has to close" TextWrapping="Wrap" />
                                            </CheckBox>
                                            <TextBlock Margin="23,2,0,0" Style="{StaticResource OP_Hint}" Text="Off: the dome/roof is left open and a red note is shown, because the telescope may not be clear of it. The run pauses; in GS Server connect and run AutoHome, then press Start sequence." />
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>

                                <Expander Style="{StaticResource OP_Section}">
                                    <Expander.Header>
                                        <TextBlock Style="{StaticResource OP_Heading}" Text="WHEN DISCONNECTING" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding Options.CloseGuiderAppOnDisconnect}" Style="{StaticResource OP_Check}">
                                            <TextBlock Text="Close PHD2 when the guider is disconnected" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <TextBlock Margin="23,2,0,0" Style="{StaticResource OP_Hint}" Text="PHD2 disconnects its own guide camera and mount, then closes. NINA's disconnect alone leaves PHD2 open with its equipment connected." />
                                        <CheckBox Margin="0,10,0,0" IsChecked="{Binding Options.CloseMountAppOnDisconnect}" Style="{StaticResource OP_Check}">
                                            <TextBlock Text="Close the mount software when the mount is disconnected" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <TextBlock Margin="23,2,0,0" Style="{StaticResource OP_Hint}" Text="For an ASCOM mount program such as GS Server: PHD2 lets go of the mount first, then the program closes by itself. If it is still open after 30 s (another program uses it), it is left open and a note is shown." />
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource OP_Hint}" Text="Both work with Disconnect Equipment (Guider, Mount) and Disconnect All Equipment wherever they are in the sequence, while NINA's sequence runs. Disconnecting by hand in NINA's Equipment tab is not affected." />
                                    </StackPanel>
                                </Expander>

                                <Expander Style="{StaticResource OP_Section}">
                                    <Expander.Header>
                                        <TextBlock Style="{StaticResource OP_Heading}" Text="KEEP CONNECTED" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OP_Hint}" Text="These devices are connected when you press Run and stay connected the whole time, also after 4 End, so the planner can always watch the weather, switch power and close the dome. Power them outside any switch you turn off in 4 End." />
                                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding KeepItems}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <local:AutoColumnsPanel ColumnGap="10" MaxColumns="3" MinColumnWidth="140" RowGap="0" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Margin="0,4" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding Locked, Converter={x:Static local:InvertBool.Instance}}" Style="{StaticResource OP_Check}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Label}" />
                                                            <TextBlock FontSize="11" Opacity="0.65" Text="{Binding Note}" Visibility="{Binding Note, Converter={StaticResource OP_TextVisible}}" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Expander>

                                <Expander Style="{StaticResource OP_Section}">
                                    <Expander.Header>
                                        <TextBlock Style="{StaticResource OP_Heading}" Text="DEFAULTS FOR NEW TARGETS" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <local:AutoColumnsPanel ColumnGap="8" MaxColumns="2" MinColumnWidth="220" RowGap="8">
                                            <Border Padding="10,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                                <StackPanel>
                                                    <TextBlock Margin="0,0,0,6" Style="{StaticResource OP_Strong}" Text="DELAY:" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Width="110" VerticalAlignment="Center" Text="⧗ Delay first" />
                                                        <TextBox Width="60" Text="{Binding Options.DefaultDelayFirst}" />
                                                        <TextBlock VerticalAlignment="Center" Text=" s" />
                                                    </StackPanel>
                                                    <TextBlock Margin="0,2,0,8" Style="{StaticResource OP_Hint}" Text="Wait before the first exposure each time a target starts or resumes, e.g. to let the mount settle after centering." />
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Width="110" VerticalAlignment="Center" Text="⧗ Delay between" />
                                                        <TextBox Width="60" Text="{Binding Options.DefaultDelayBetween}" />
                                                        <TextBlock VerticalAlignment="Center" Text=" s" />
                                                    </StackPanel>
                                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource OP_Hint}" Text="Wait between each exposure." />
                                                </StackPanel>
                                            </Border>
                                            <Border Padding="10,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                                <StackPanel>
                                                    <TextBlock Margin="0,0,0,6" Style="{StaticResource OP_Strong}" Text="ORDER:" />
                                                    <RadioButton Content="Rotate through filters" GroupName="OP_DefaultOrder" IsChecked="{Binding Options.DefaultOrder, Converter={StaticResource OP_EnumBool}, ConverterParameter=RotateThroughFilters}" Style="{StaticResource OP_Radio}" />
                                                    <RadioButton Content="Finish each row first" GroupName="OP_DefaultOrder" IsChecked="{Binding Options.DefaultOrder, Converter={StaticResource OP_EnumBool}, ConverterParameter=FinishEachRowFirst}" Style="{StaticResource OP_Radio}" />
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource OP_Hint}" Text="Rotate takes one frame per row in turn (Ha, OIII, SII, Ha…). Finish completes each row before moving to the next." />
                                                </StackPanel>
                                            </Border>
                                        </local:AutoColumnsPanel>
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource OP_Hint}" Text="Used when you add a target. Each target can still change its own values on the Targets tab." />
                                        <Button Margin="0,8,0,0" HorizontalAlignment="Left" Command="{Binding ApplyDefaultsToAllCommand}" Content="Apply these to all existing targets" Style="{StaticResource OP_Small}" />
                                    </StackPanel>
                                </Expander>

                                <Expander Style="{StaticResource OP_Section}">
                                    <Expander.Header>
                                        <TextBlock Style="{StaticResource OP_Heading}" Text="BETWEEN TARGETS" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <WrapPanel>
                                            <TextBlock VerticalAlignment="Center" Text="If the next target starts more than " />
                                            <TextBox Width="52" Text="{Binding Options.GapMinutes}" />
                                            <TextBlock VerticalAlignment="Center" Text=" min later:" />
                                        </WrapPanel>
                                        <local:AutoColumnsPanel Margin="0,8,0,0" ColumnGap="12" MaxColumns="2" MinColumnWidth="200" RowGap="8">
                                            <StackPanel>
                                                <TextBlock Margin="0,0,0,4" FontSize="12" Opacity="0.7" Text="Mount during the wait" />
                                                <ComboBox DisplayMemberPath="Label" ItemsSource="{Binding GapMountChoices}" SelectedValue="{Binding Options.GapMount}" SelectedValuePath="Value" />
                                            </StackPanel>
                                            <StackPanel IsEnabled="{Binding GapCloseDomeVisible}">
                                                <TextBlock Margin="0,0,0,4" FontSize="12" Opacity="0.7" Text="Close dome during the wait" />
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding Options.GapCloseDome}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </local:AutoColumnsPanel>
                                        <Border Margin="0,10,0,0" Padding="10,8" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock Margin="0,0,0,2" FontSize="12" Opacity="0.7" Text="When the wait starts" />
                                                <ItemsControl ItemsSource="{Binding GapWaitSteps}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Margin="0,2" Style="{StaticResource OP_Chip}">
                                                                    <TextBlock FontSize="12" Text="{Binding Text}" />
                                                                </Border>
                                                                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Opacity="0.6" Text="→" Visibility="{Binding HasNext, Converter={StaticResource OP_BoolVisible}}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Margin="0,8,0,2" FontSize="12" Opacity="0.7" Text="{Binding GapResumeLabel}" />
                                                <ItemsControl ItemsSource="{Binding GapResumeSteps}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Margin="0,2" Style="{StaticResource OP_Chip}">
                                                                    <TextBlock FontSize="12" Text="{Binding Text}" />
                                                                </Border>
                                                                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Opacity="0.6" Text="→" Visibility="{Binding HasNext, Converter={StaticResource OP_BoolVisible}}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource OP_Hint}" Text="{Binding GapHint}" />
                                    </StackPanel>
                                </Expander>

                                <Expander Style="{StaticResource OP_Section}">
                                    <Expander.Header>
                                        <TextBlock Style="{StaticResource OP_Heading}" Text="DISPLAY" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <WrapPanel>
                                            <TextBlock Margin="0,0,10,4" VerticalAlignment="Center" Text="Text size" />
                                            <Slider Width="200" Margin="0,0,10,4" VerticalAlignment="Center" IsSnapToTickEnabled="True" Maximum="18" Minimum="10" TickFrequency="0.5" Value="{Binding Options.PanelTextSize}" />
                                            <TextBlock Margin="0,0,12,4" VerticalAlignment="Center" Style="{StaticResource OP_Mono}" Text="{Binding Options.PanelTextSize, StringFormat={}{0:0.#} px}" />
                                            <Button Margin="0,0,0,4" VerticalAlignment="Center" Command="{Binding ResetTextSizeCommand}" Content="Reset to 10 px" Style="{StaticResource OP_Link}" />
                                        </WrapPanel>
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource OP_Hint}" Text="Text size of the Observatory Planner panel, from 10 to 18 px; the whole panel grows or shrinks with it. NINA's own text size is 12 and is not changed." />
                                    </StackPanel>
                                </Expander>

                                <Expander Style="{StaticResource OP_Section}">
                                    <Expander.Header>
                                        <TextBlock Style="{StaticResource OP_Heading}" Text="CONFIRMATIONS" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <CheckBox Content="Ask before deleting a target" IsChecked="{Binding Options.ConfirmDeleteTarget}" Style="{StaticResource OP_Check}" />
                                        <CheckBox Margin="0,6,0,0" Content="Ask before deleting an exposure row" IsChecked="{Binding Options.ConfirmDeleteExposure}" Style="{StaticResource OP_Check}" />
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource OP_Hint}" Text="Choosing &quot;Don't ask me again&quot; in a delete dialog turns the matching option off. Turn it back on here." />
                                        <Button Margin="0,8,0,0" HorizontalAlignment="Left" Command="{Binding ResetConfirmationsCommand}" Content="Turn all confirmations back on" Style="{StaticResource OP_Small}" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- =================== INFO (opened with the ! next to the gear): a guide from scratch, one collapsible section per topic =================== -->
                    <TabItem Header="Info" Visibility="Collapsed">
                        <ScrollViewer Margin="0,8,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="760" HorizontalAlignment="Stretch">
                                <Expander Style="{StaticResource OP_Section}">
                                    <Expander.Header>
                                        <TextBlock Style="{StaticResource OP_Heading}" Text="GETTING STARTED" TextWrapping="Wrap" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="The Observatory Planner runs your observatory on its own, SGP style. You keep a list of targets with their exposures here; the planner powers up and prepares the equipment, images the targets in order, and shuts everything down at dawn or when the weather turns. With a safety monitor it does this every night by itself." />
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="First run, step by step" />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="1. Choose how you run: ⚙ Options › Run mode. &quot;Run with safety&quot; if NINA has a safety monitor (it runs every night); &quot;Run without safety&quot; if not (each Run goes through your targets once while you stay nearby)." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="2. Load a default workflow: open &quot;How the night runs&quot; below and press &quot;Load a default workflow…&quot;. It fills the four stages (1 Begin, 2 Start of target, 3 While imaging, 4 End) in NINA's Advanced Sequencer." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="3. Make the stages fit your equipment: Sequence tab › &quot;✎ Edit in Advanced Sequencer&quot;. Check the power switch names, the cooling temperature, the dome steps and so on. Warnings under a stage point out steps in the wrong order." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="4. Check ⚙ Options: Keep connected (the devices that must stay on, e.g. the safety monitor), the Night setting and what happens when it turns unsafe." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="5. Add targets on the Targets tab with ＋ ▾: an empty target, the target framed in NINA's Framing Assistant, or a mosaic. In ⚙ Target settings set the coordinates and, if you want, a start and end time or altitude. &quot;Adding targets&quot; below shows how to take them from the Sky Atlas or the Framing Assistant." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="6. Add exposure rows for each target: type, filter, exposure time, binning and how many frames (Repeat)." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="7. Press &quot;▶ Run forever&quot; (with safety) or &quot;▶ Run&quot; (without). The top of the panel shows what it is doing." />
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="Everything is saved automatically: the target list after every change and every frame, the options at once, the workflow whenever it changes. After a NINA restart the last workflow and target list come back." />
                                    </StackPanel>
                                </Expander>

<Expander IsExpanded="False" Style="{StaticResource OP_Section}">
                                    <Expander.Header>
                                        <WrapPanel>
                                            <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Style="{StaticResource OP_Heading}" Text="HOW THE NIGHT RUNS" />
                                            <TextBlock VerticalAlignment="Center" FontSize="12" Opacity="0.7" Text="{Binding ModeSummary}" />
                                        </WrapPanel>
                                    </Expander.Header>
                                    <StackPanel>
                                        <WrapPanel>
                                            <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding ModeSummary}" />
                                            <TextBlock VerticalAlignment="Center" FontSize="12" Opacity="0.7" Text="  ·  " />
                                            <Button Command="{Binding GoOptionsCommand}" Content="change in ⚙ Options" FontSize="12" Style="{StaticResource OP_Link}" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,10,0,6">
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding WithSafety, Converter={StaticResource OP_BoolVisible}}">
                                                <Border Margin="0,2" Padding="10,5" BorderBrush="{StaticResource OP_Muted}" BorderThickness="1" CornerRadius="6">
                                                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource OP_Muted}" Text="Wait for safe" />
                                                </Border>
                                                <TextBlock Style="{StaticResource OP_Arrow}" Text="→" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Margin="0,2" Padding="8,4" Background="{DynamicResource TertiaryBackgroundBrush}" BorderBrush="{StaticResource OP_Safe}" BorderThickness="1" CornerRadius="6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="18" Height="18" Margin="0,0,6,0" Background="{StaticResource OP_Safe}" CornerRadius="9"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OP_AccentInk}" Text="1" /></Border>
                                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Begin" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Style="{StaticResource OP_Arrow}" Text="→" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Margin="0,2" Padding="8,4" Background="{DynamicResource TertiaryBackgroundBrush}" BorderBrush="{StaticResource OP_Info}" BorderThickness="1" CornerRadius="6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="18" Height="18" Margin="0,0,6,0" Background="{StaticResource OP_Info}" CornerRadius="9"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OP_AccentInk}" Text="2" /></Border>
                                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Start of target" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Style="{StaticResource OP_Arrow}" Text="→" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Margin="0,2" Padding="8,4" Background="{DynamicResource TertiaryBackgroundBrush}" BorderBrush="{StaticResource OP_Accent}" BorderThickness="1" CornerRadius="6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Imaging + " />
                                                        <Border Width="18" Height="18" Margin="2,0,4,0" Background="{StaticResource OP_Accent}" CornerRadius="9"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OP_AccentInk}" Text="3" /></Border>
                                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="triggers" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Style="{StaticResource OP_Arrow}" Text="→" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Margin="0,2" Padding="8,4" Background="{DynamicResource TertiaryBackgroundBrush}" BorderBrush="{StaticResource OP_Unsafe}" BorderThickness="1" CornerRadius="6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="18" Height="18" Margin="0,0,6,0" Background="{StaticResource OP_Unsafe}" CornerRadius="9"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OP_AccentInk}" Text="4" /></Border>
                                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="End" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock FontSize="18" Foreground="{StaticResource OP_Accent}" Style="{StaticResource OP_Arrow}" Text="↺" ToolTip="Repeats" Visibility="{Binding WithSafety, Converter={StaticResource OP_BoolVisible}}" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource OP_Hint}" Text="{Binding CycleHint}" />
                                        <Border Style="{StaticResource OP_WarnBox}" Tag="OP_Warn" Visibility="{Binding NoSafetyWarningShown, Converter={StaticResource OP_BoolVisible}}">
                                            <DockPanel>
                                                <Button Margin="8,0,0,0" Padding="2,0" VerticalAlignment="Top" Command="{Binding DismissWarningCommand}" CommandParameter="no-safety" Content="✕" DockPanel.Dock="Right" Style="{StaticResource OP_Flat}" ToolTip="Close this message" />
                                                <TextBlock Style="{StaticResource OP_WarnText}" Text="⚠ No safety monitor: nothing closes the dome or stops imaging for rain or clouds. Stay nearby while it runs." />
                                            </DockPanel>
                                        </Border>
                                        <WrapPanel Margin="0,10,0,0">
                                            <TextBlock Margin="0,0,8,0" Style="{StaticResource OP_Label}" Text="KEEP CONNECTED" />
                                            <ItemsControl ItemsSource="{Binding KeepChips}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource OP_Chip}">
                                                            <TextBlock FontSize="12" Text="{Binding}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Margin="2,0,0,0" VerticalAlignment="Center" Command="{Binding GoOptionsCommand}" Content="edit" FontSize="12" Style="{StaticResource OP_Link}" />
                                        </WrapPanel>
                                        <Button Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding LoadDefaultWorkflowCommand}" Content="Load a default workflow…" Style="{StaticResource OP_Small}" />
                                    </StackPanel>
                                </Expander>

                                <Expander IsExpanded="False" Style="{StaticResource OP_Section}">
                                    <Expander.Header>
                                        <TextBlock Style="{StaticResource OP_Heading}" Text="ADDING TARGETS: SKY ATLAS, FRAMING ASSISTANT, PLANETARIUM" TextWrapping="Wrap" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="From NINA's Sky Atlas" />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="1. Open NINA's Sky Atlas tab and search or filter for your object." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="2. On the object, click &quot;Set for framing assistant&quot;. (Not &quot;Add Target to Sequence&quot;: that adds it to NINA's own sequencer, not to the planner.)" />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="3. NINA opens the Framing tab with the object. Press &quot;Load Image&quot; if no picture is shown, then frame it: move the camera rectangle, turn it to the angle you want, or set up mosaic panels." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="4. Back in the planner (Imaging tab): Targets tab › ＋ ▾ › &quot;From Framing Assistant&quot;, or &quot;Mosaic from Framing Assistant&quot; for one target per panel." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="5. The name, coordinates and rotation are filled in. Open ⚙ Target settings to set a start or end if you want, then add exposure rows." />
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="From the Framing Assistant directly" />
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="Open NINA's Framing tab, search the object by name (or enter coordinates), press &quot;Load Image&quot; and frame it, then use ＋ ▾ › &quot;From Framing Assistant&quot; as above. If nothing is framed yet, the planner tells you to frame a target first." />
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="Into a target you already have" />
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="In ⚙ Target settings, &quot;Get from: Framing Assistant&quot; takes the name, coordinates and rotation of what is framed now. &quot;Get from: Planetarium&quot; takes the object selected in your planetarium program (Stellarium, Cartes du Ciel, TheSkyX and so on; set it up in NINA's Options › Planetarium and select the object there first)." />
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="By hand" />
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="＋ ▾ › &quot;Empty target&quot; opens Target settings: type a name and the coordinates (for example 05h35m17s and -05°23'28&quot;, or hours and degrees)." />
                                    </StackPanel>
                                </Expander>

                                <Expander IsExpanded="False" Style="{StaticResource OP_Section}">
                                    <Expander.Header>
                                        <TextBlock Style="{StaticResource OP_Heading}" Text="THE TOP OF THE PANEL" TextWrapping="Wrap" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="The block at the top always shows the state of the run, even while the page below scrolls." />
                                        <Border Margin="0,6,0,2" HorizontalAlignment="Left" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                            <Image MaxWidth="520" Source="pack://application:,,,/NINA.ObservatoryPlanner;component/UI/Images/info-top.png" Stretch="Uniform" StretchDirection="DownOnly" />
                                        </Border>
                                        <TextBlock Margin="0,0,0,6" FontSize="11" FontStyle="Italic" Style="{StaticResource OP_InfoText}" Text="Example: imaging, with a safety monitor. The stage running now is orange." />
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="The state (left)" />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• Stopped: nothing runs. Press Run forever or Run." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• Safe / Unsafe: running with a safety monitor, and what the monitor says now. No safety data: the monitor is not connected." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• No safety monitor: running in &quot;Run without safety&quot;." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• Paused: the run is paused; everything stays powered. Press Start sequence to continue." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• Finished: all targets are done and 4 End has run." />
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="The buttons (right)" />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• Run forever / Run starts the run. While it runs the same button is Stop (red)." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• Pause ▾ (while running): Pause now, or Pause after this step. While a pause is due it shows Pausing… ▾, where you can cancel it. While paused it is Start sequence." />
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="The stages (second line)" />
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="Waiting for safe, 1 Begin, 2 Start of target, Imaging + 3 triggers, 4 End. The stage running now is orange; ↺ means the night loop repeats (with safety). When the line does not fit in a narrow panel, only the current stage is shown next to the state." />
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="The status text (third line)" />
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="What is happening now, for example &quot;Imaging M 31 · Ha 300 s · frame 12 of 40&quot;, a countdown, or why it is waiting. A red ⚠ in front of it means the tab you are on has a warning: click it to jump to the warning (click again for the next one). Close a warning with its ✕; it comes back only if its text changes or NINA restarts." />
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="A red box under the status text lists 4 End steps that failed the last time 4 End ran (for example a power switch)." />
                                    </StackPanel>
                                </Expander>

                                <Expander IsExpanded="False" Style="{StaticResource OP_Section}">
                                    <Expander.Header>
                                        <TextBlock Style="{StaticResource OP_Heading}" Text="TARGETS TAB: THE TARGET LIST" TextWrapping="Wrap" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <Border Margin="0,6,0,2" HorizontalAlignment="Left" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                            <Image MaxWidth="520" Source="pack://application:,,,/NINA.ObservatoryPlanner;component/UI/Images/info-targets.png" Stretch="Uniform" StretchDirection="DownOnly" />
                                        </Border>
                                        <TextBlock Margin="0,0,0,6" FontSize="11" FontStyle="Italic" Style="{StaticResource OP_InfoText}" Text="Example: three targets; the first is selected, the third is not ticked." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• Ticked targets are imaged; the order of the list is the order of priority (top first). Use ↑ ↓ to move a target, ⧉ to duplicate it (without progress) and 🗑 to delete it." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• The planner takes the first ticked target that is not complete and that may be imaged now: inside its own start and end, and in the night (⚙ Options › Weather › Night). It checks again after every frame, so a target higher up takes over when its time comes." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• Icons: ▶ being imaged now, ‖ waiting (orange: the run is paused on it), ■ not ticked or nothing to take, ✔ complete. Hover over an icon for the word." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• The percentage and the thin bar show the frames taken of all ticked rows. ⚙ opens the target's settings." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• Target lists: New, Open…, Save and Save as… (or Target Actions ▾ in a narrow panel). The ✔ next to the name means the list is saved; it is saved automatically after every change." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• If the next target starts more than the set minutes later, the mount waits as chosen in ⚙ Options › Between targets (keep tracking, park, or find home)." />
                                    </StackPanel>
                                </Expander>

                                <Expander IsExpanded="False" Style="{StaticResource OP_Section}">
                                    <Expander.Header>
                                        <TextBlock Style="{StaticResource OP_Heading}" Text="TARGET SETTINGS" TextWrapping="Wrap" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• Name and position (RA and Dec, J2000). &quot;Get from&quot; fills them from NINA's Framing Assistant or your planetarium program." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• Slew now / Center now move the telescope there to check the framing (with a warning when the target is low or the mount is parked)." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• When target starts: slew and center (plate solve), slew only, or don't move (for example for flats)." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• Start at / End at: tick to use a limit. Each has an altitude and a clock time that are linked for tonight: change one and the other follows. The 🔒 chooses which one stays the same on other nights (shaded orange). ⛓ means the target never reaches that altitude tonight, so only the time is used. &quot;tomorrow&quot; means the time is after midnight." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• No start: the target starts as soon as it is safe and it is its turn. No end: it runs until it is unsafe, the night ends or all frames are taken." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• 📈 Planning tools: tonight's altitude chart. Left-click sets the start time, right-click the end time." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• Rotate camera to: the rotator angle for this target (NINA also accepts the angle + 180°)." />
                                    </StackPanel>
                                </Expander>

                                <Expander IsExpanded="False" Style="{StaticResource OP_Section}">
                                    <Expander.Header>
                                        <TextBlock Style="{StaticResource OP_Heading}" Text="TARGETS TAB: EXPOSURES" TextWrapping="Wrap" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <Border Margin="0,6,0,2" HorizontalAlignment="Left" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                            <Image MaxWidth="520" Source="pack://application:,,,/NINA.ObservatoryPlanner;component/UI/Images/info-exposures.png" Stretch="Uniform" StretchDirection="DownOnly" />
                                        </Border>
                                        <TextBlock Margin="0,0,0,6" FontSize="11" FontStyle="Italic" Style="{StaticResource OP_InfoText}" Text="Example: the selected target with its delays, order and three exposure rows; the green bar is a finished row." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• DELAY: wait before the first frame each time the target starts or resumes (e.g. to let the mount settle), and between frames." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• ORDER: &quot;Rotate through filters&quot; takes one frame of each row in turn; &quot;Finish each row first&quot; completes a row before the next." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• Each row: # (priority, ▲▼ to move; ▶ marks the row being taken now), Run (tick to take it), Type (Light, Dark, Bias, Flat), Filter, Exposure in seconds, Binning, Repeat (how many frames), Progress and ✕ to delete. ▲▼ next to Exposure and Repeat change them by one." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• Click the progress bar to correct the frames already taken (for example after deleting bad frames)." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• Frames use the camera's gain from NINA. Frame numbers in file names ($$FRAMENR$$) continue across nights, pauses and weather stops." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• In a narrow panel the rows wrap onto more lines and the progress bar moves under the row; four rows show, then the rows scroll." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• ◎ Autofocus (while imaging) runs autofocus before the next frame; the frame being taken finishes first." />
                                    </StackPanel>
                                </Expander>

                                <Expander IsExpanded="False" Style="{StaticResource OP_Section}">
                                    <Expander.Header>
                                        <TextBlock Style="{StaticResource OP_Heading}" Text="SEQUENCE TAB: THE FOUR STAGES" TextWrapping="Wrap" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="Each stage is an instruction set in NINA's Advanced Sequencer, inside the &quot;Observatory Planner&quot; block. Edit them there (✎ Edit in Advanced Sequencer) with any instruction, also from other plugins. This tab shows what is in them." />
                                        <Border Margin="0,6,0,2" HorizontalAlignment="Left" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                            <Image MaxWidth="520" Source="pack://application:,,,/NINA.ObservatoryPlanner;component/UI/Images/info-stage.png" Stretch="Uniform" StretchDirection="DownOnly" />
                                        </Border>
                                        <TextBlock Margin="0,0,0,6" FontSize="11" FontStyle="Italic" Style="{StaticResource OP_InfoText}" Text="Example: stage 1 Begin of a workflow, with a warning about a step in the wrong order." />
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="1 Begin" />
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="Powers up and prepares: switches on, connects the equipment, cools the camera, opens the dome, unparks. With safety it runs each evening and after every weather shutdown; without safety once at the start." />
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="2 Start of target" />
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="Runs when a target starts (and when it resumes after unsafe): slew and center, start guiding. The target's &quot;When target starts&quot; choice replaces the centering step." />
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="3 While imaging (triggers)" />
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="Triggers checked between frames: meridian flip, dither, autofocus. Use &quot;AF after filter change (planner)&quot; rather than NINA's own filter-change trigger." />
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="4 End" />
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="Shuts down: stop guiding, park, close the dome, warm the camera, switch power off. It runs when it turns unsafe, at dawn, when everything is done, or on Stop, and always runs to the end." />
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="Workflows and warnings" />
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="The four stages together are a workflow. Open…, Save and Save as… (or Sequence Actions ▾) keep several, for example summer and winter. The ✔ next to the name means it is saved. Red warnings under a stage point out steps that will fail, for example a power switch used before the switch hub is connected. Click a stage heading to fold it away; ✎ in the heading still opens the sequencer." />
                                    </StackPanel>
                                </Expander>

                                <Expander IsExpanded="False" Style="{StaticResource OP_Section}">
                                    <Expander.Header>
                                        <TextBlock Style="{StaticResource OP_Heading}" Text="WEATHER AND THE NIGHT" TextWrapping="Wrap" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• With a safety monitor the planner waits for &quot;safe&quot; (plus the wait set in ⚙ Options › Run mode, if any) before 1 Begin." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• When it turns unsafe during the night it either runs 4 End (full shutdown) or, if chosen in ⚙ Options › Weather, closes up and waits: guiding stops, the mount parks and the dome closes, but power and camera cooling stay on. When it is safe again it reopens and continues; if it stays unsafe too long or the morning comes, 4 End runs." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• The Night setting (⚙ Options › Weather) keeps imaging out of daylight: no target starts before the Sun is below the chosen twilight, and no frame starts that would end after it rises above it. When nothing can be imaged any more, the night is over and 4 End runs." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• Without a safety monitor nothing protects the equipment from rain or clouds: stay nearby." />
                                    </StackPanel>
                                </Expander>

                                <Expander IsExpanded="False" Style="{StaticResource OP_Section}">
                                    <Expander.Header>
                                        <TextBlock Style="{StaticResource OP_Heading}" Text="GUIDING AND FOCUS" TextWrapping="Wrap" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• Autofocus runs before the first frame after 1 Begin and after a weather close-up (⚙ Options › Run mode), and after a filter change with the &quot;AF after filter change (planner)&quot; trigger in stage 3." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• Guide star lost (PHD2): a frame is dropped and taken again; the planner waits for PHD2 to find the star again, then either stops for the night or goes to the next target (⚙ Options › Guide star lost)." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• Guiding error check (off by default): frames start only when the guiding error is below your limit, and a frame is restarted when the error stays too high (⚙ Options › Guiding error)." />
                                    </StackPanel>
                                </Expander>

                                <Expander IsExpanded="False" Style="{StaticResource OP_Section}">
                                    <Expander.Header>
                                        <TextBlock Style="{StaticResource OP_Heading}" Text="COLOUR CAMERAS AND FILTER WHEELS" TextWrapping="Wrap" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="Colour (one-shot colour) camera, no filter wheel" />
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="Leave the filter wheel empty (&quot;No Device&quot;) in NINA's equipment. The Filter column then shows &quot;—&quot;: rows have no filter and the planner never changes one. Everything else works as usual, with or without a safety monitor; &quot;Rotate through filters&quot; makes no difference and &quot;AF after filter change&quot; never runs. File names get no filter name ($$FILTER$$ is empty), as in NINA." />
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="Motorised filter wheel" />
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="Each row picks a filter from the wheel's list in your NINA profile; the planner switches to it before the row's frames." />
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="NINA's &quot;Manual Filter Wheel&quot;" />
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="For a filter drawer or a wheel turned by hand. NINA asks you to change the filter with a message that waits for a click, and nothing else could run meanwhile, not even 4 End when it turns unsafe. So the planner does not let NINA ask: when the next frame needs another filter, the run pauses with &quot;Change the filter to … by hand, then press Start sequence&quot;. While paused the weather is still watched (unsafe runs 4 End). After Start sequence NINA shows its message once; click OK and imaging goes on." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• Unattended, use one filter per night: a red warning on the Targets tab appears when the ticked targets use more than one filter." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• Set the plate solving and autofocus filters in NINA's options to the current filter, or NINA will ask for a change there too." />
                                    </StackPanel>
                                </Expander>

                                <Expander IsExpanded="False" Style="{StaticResource OP_Section}">
                                    <Expander.Header>
                                        <TextBlock Style="{StaticResource OP_Heading}" Text="ROTATOR AND FLAT PANEL" TextWrapping="Wrap" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="Camera rotator" />
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="Tick &quot;Rotate camera to&quot; in a target's settings. With &quot;Slew and center&quot; the camera turns to that sky angle while centering (plate solving). With &quot;Slew only&quot; or &quot;Don't move&quot; the planner turns the rotator itself, before guiding starts: to the sky angle when a plate solve has synced the rotator, otherwise to the same mechanical angle (then the sky angle can differ a little; the log says so). Without a connected rotator the rotation is left out and the log says why. Connect All Equipment in 1 Begin connects the rotator, and Start sequence reconnects it if needed." />
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="Flat panel (with or without a cover)" />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• Before a target starts (slew, centering, guiding, light frames) the planner opens a closed cover and switches the light off, so nothing is taken through a cover that 4 End or the flats closed." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• Flat rows: the cover closes and the light comes on at the panel's current brightness; set the exposure time in the row. Dark and bias rows close the cover with the light off." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• When the target's frames end after flats, the light is switched off and the cover stays closed. The next target opens it again." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• Put flat rows last in a target: closing the cover interrupts guiding. For flats per filter at the end of the night, NINA's Trained Flat Exposure instructions in 4 End work too." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• Without a flat panel nothing of this happens; a panel without a cover or without a switchable light only does what it can." />
                                    </StackPanel>
                                </Expander>

                                <Expander IsExpanded="False" Style="{StaticResource OP_Section}">
                                    <Expander.Header>
                                        <TextBlock Style="{StaticResource OP_Heading}" Text="PAUSE AND START SEQUENCE" TextWrapping="Wrap" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="When Pause is available" />
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="From the start of 1 Begin until 4 End starts. While waiting for safe or for the next night nothing is powered: use Stop, and Run when you're ready." />
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="Pause now" />
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="Stops whatever is running: a frame being taken is dropped; a slew, centering, autofocus, a wait or 1 Begin is interrupted. A meridian flip, the dome shutter, park and the steps between targets finish first." />
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="Pause after this step" />
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="The frame or instruction running now finishes first." />
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="While paused" />
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="Guiding stops; tracking, the dome and power stay as they are. If the meridian flip time comes while paused, tracking stops to protect the mount. Unsafe weather while paused runs 4 End as usual." />
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="Start sequence" />
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="Checks the connections and the weather, then continues with the targets and settings as they are now. An interrupted 1 Begin continues from the step it stopped at. On the same target with the mount not moved only guiding restarts; if 2 Start of target was interrupted or the mount moved, it runs again. If the paused target was turned off, finished or is outside its time window, the next target is taken and the status says why." />
                                    </StackPanel>
                                </Expander>

                                <Expander IsExpanded="False" Style="{StaticResource OP_Section}">
                                    <Expander.Header>
                                        <TextBlock Style="{StaticResource OP_Heading}" Text="STOP AND 4 END" TextWrapping="Wrap" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• Stop asks first. The frame being taken is dropped, then 4 End runs (park, close the dome, warm the camera, power off) and the run ends." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• 4 End always runs to the end and cannot be paused. A step that fails is reported in red at the top, and 4 End carries on with the next step." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• If a step elsewhere stops NINA's sequence (its error behaviour is &quot;Abort&quot; or &quot;Skip to end of sequence instructions&quot;), 4 End still runs and the status says why." />
                                    </StackPanel>
                                </Expander>

                                <Expander IsExpanded="False" Style="{StaticResource OP_Section}">
                                    <Expander.Header>
                                        <TextBlock Style="{StaticResource OP_Heading}" Text="EDITING WHILE A RUN IS GOING" TextWrapping="Wrap" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="You can edit the stages in NINA's Advanced Sequencer and the targets here while the planner runs. This is when each change is used:" />
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="1 Begin and 4 End" />
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="Used the next time the stage runs (for 1 Begin: after the next weather stop or the next night)." />
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="2 Start of each target" />
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="The planner copies this stage when a target starts. A change is used from the next target; the target being imaged has already run it." />
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="3 While imaging (triggers)" />
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="Also copied when a target starts, and again on Start sequence after a pause. A change is used from the next target, or after the next pause." />
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="The running target block (e.g. &quot;M31&quot;) in the Advanced Sequencer" />
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="While a target runs, the planner adds a temporary target block inside the Observatory Planner block. It holds copies of stages 2 and 3 for that target only. Changes made inside it affect only the target running now and are lost when it ends. Edit stages 2 and 3 instead." />
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="Targets and exposure rows (this panel)" />
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="Used right away: the next frame takes the current exposure rows, and the next target is chosen from the current list each time imaging starts or resumes. Progress is saved after every frame." />
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="⚙ Options" />
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="Used the next time each setting is needed (for example the guiding limit before the next frame). The run mode can only be changed while stopped." />
                                    </StackPanel>
                                </Expander>

                                <Expander IsExpanded="False" Style="{StaticResource OP_Section}">
                                    <Expander.Header>
                                        <TextBlock Style="{StaticResource OP_Heading}" Text="ADDING SECTIONS IN THE ADVANCED SEQUENCER" TextWrapping="Wrap" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="Inside a stage: yes" />
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="New instructions and instruction sets belong inside one of the four stages, for example a flats set inside 4 End. They run each time that stage runs; 4 End also runs on every unsafe shutdown." />
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="Directly in the Observatory Planner block: no" />
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="A section placed between the stages (not inside one) does not run and is removed when the run starts. Known issue, on the to-do list." />
                                        <TextBlock Style="{StaticResource OP_InfoHead}" Text="Outside the Observatory Planner block" />
                                        <TextBlock Style="{StaticResource OP_InfoText}" Text="NINA's Start area runs once when NINA's sequence starts, before 1 Begin. Anything after the block or in NINA's End area runs only after the planner stops, when 4 End has already switched the equipment off." />
                                    </StackPanel>
                                </Expander>

                                <Expander IsExpanded="False" Style="{StaticResource OP_Section}">
                                    <Expander.Header>
                                        <TextBlock Style="{StaticResource OP_Heading}" Text="MOUNT SOFTWARE AND PHD2" TextWrapping="Wrap" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• GS Server mount recovery (⚙ Options › Mount recovery): if GS Server stops during 1 Begin, 2 Start of target or imaging, the planner reconnects the mount, runs AutoHome with the home sensors, unparks and continues. If that fails the run pauses with a red note, and the dome/roof is left open unless you allowed closing it anyway (the telescope may not be clear of it)." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• The &quot;GS Server AutoHome&quot; instruction (Observatory Planner category in the Advanced Sequencer) runs AutoHome in any stage." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• When disconnecting (⚙ Options): Disconnect Equipment / Disconnect All in the stages can also close PHD2 (after it disconnects its own camera and mount) and the mount's ASCOM program such as GS Server." />
                                    </StackPanel>
                                </Expander>

                                <Expander IsExpanded="False" Style="{StaticResource OP_Section}">
                                    <Expander.Header>
                                        <TextBlock Style="{StaticResource OP_Heading}" Text="RESTARTS, FILES AND LOGS" TextWrapping="Wrap" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• &quot;Start the run when NINA starts&quot; (⚙ Options › Run mode) restarts the run after a power cut or a Windows update; a run that was paused stays paused." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• Target lists, workflows and options are kept per NINA profile in Documents\N.I.N.A\Observatory Planner\Profiles\&lt;profile&gt;, in the folders &quot;Target lists&quot; and &quot;Workflows&quot;." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• A log of each NINA session (one line per event) is in Documents\N.I.N.A\Observatory Planner\Logs; the planner also writes to NINA's own log." />
                                        <TextBlock Style="{StaticResource OP_InfoBullet}" Text="• Text size (⚙ Options › Display) makes the whole panel larger or smaller. The panel rearranges itself for narrow and wide docks." />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <!--  gear and ! (info) at the right end of the tab row  -->
                <StackPanel Margin="0,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                    <Button Command="{Binding GoOptionsCommand}" ToolTip="Options">
                        <Button.Style>
                            <Style BasedOn="{StaticResource OP_Flat}" TargetType="Button">
                                <Setter Property="Padding" Value="8,4" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPlannerTab}" Value="2">
                                        <Setter Property="Foreground" Value="{StaticResource OP_Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
