<ResourceDictionary
    x:Class="NINA.ObservatoryPlanner.UI.PlannerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NINA.ObservatoryPlanner.UI">

    <!--
        Layout follows the Observatory Planner mockup: status strip, phase chain, tabs (Targets | Equipment & Safety | gear),
        list | detail on the Targets tab, four coloured stage boxes on Equipment & Safety.
        Surfaces and text use NINA's theme brushes; the mockup's colours mark state (safe, target, imaging, end).
        Shared OP_* styles are also used by the planner's dialogs (this dictionary is merged into the application).
    -->

    <BooleanToVisibilityConverter x:Key="OP_BoolVisible" />
    <local:BoolCollapsedConverter x:Key="OP_BoolCollapsed" />
    <local:EqualsVisibleConverter x:Key="OP_EqualsVisible" />
    <local:TextVisibleConverter x:Key="OP_TextVisible" />
    <local:EnumBoolConverter x:Key="OP_EnumBool" />
    <local:PlusOneConverter x:Key="OP_PlusOne" />
    <local:TargetStateConverter x:Key="OP_TargetState" />

    <SolidColorBrush x:Key="OP_Safe" Color="#57B97C" />
    <SolidColorBrush x:Key="OP_Info" Color="#6AA7D8" />
    <SolidColorBrush x:Key="OP_Accent" Color="#E3A646" />
    <SolidColorBrush x:Key="OP_AccentInk" Color="#1A1306" />
    <SolidColorBrush x:Key="OP_Unsafe" Color="#E0645C" />
    <SolidColorBrush x:Key="OP_Muted" Color="#8B939C" />
    <FontFamily x:Key="OP_MonoFont">Consolas, Courier New</FontFamily>

    <Style x:Key="OP_Box" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style x:Key="OP_Heading" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style x:Key="OP_Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="OP_Hint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Opacity" Value="0.65" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="OP_Mono" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource OP_MonoFont}" />
    </Style>
    <Style x:Key="OP_WarnBox" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource OP_Unsafe}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="Background" Value="#1AE0645C" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="CornerRadius" Value="0,4,4,0" />
    </Style>
    <Style x:Key="OP_WarnText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OP_Unsafe}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="OP_Chip" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource TertiaryBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="0,2,6,2" />
    </Style>

    <!--  Buttons with their own template, so they look the same in the panel and the dialogs  -->
    <Style x:Key="OP_Btn" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="bd" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource OP_Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource OP_Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="OP_Small" BasedOn="{StaticResource OP_Btn}" TargetType="ButtonBase">
        <Setter Property="Padding" Value="9,2" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style x:Key="OP_Primary" BasedOn="{StaticResource OP_Btn}" TargetType="ButtonBase">
        <Setter Property="Background" Value="{StaticResource OP_Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource OP_Accent}" />
        <Setter Property="Foreground" Value="{StaticResource OP_AccentInk}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="OP_Icon" BasedOn="{StaticResource OP_Btn}" TargetType="ButtonBase">
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style x:Key="OP_Flat" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="3,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="bd" Padding="{TemplateBinding Padding}" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
                        <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="OP_Link" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource OP_Info}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="t" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Content}" TextDecorations="Underline" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Foreground" Value="{StaticResource OP_Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Check box with its label shown (NINA's own check box is an ON/OFF switch without a label)  -->
    <Style x:Key="OP_Check" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Background="Transparent" Orientation="Horizontal">
                        <Border x:Name="box" Width="16" Height="16" VerticalAlignment="Center" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                            <Path x:Name="mark" Data="M3,8 L6.5,11.5 L12.5,4.5" Stroke="{StaticResource OP_AccentInk}" StrokeThickness="2" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter x:Name="label" Margin="7,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource OP_Accent}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource OP_Accent}" />
                            <Setter TargetName="mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource OP_Accent}" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="label" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="OP_Radio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,2,14,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Background="Transparent" Orientation="Horizontal">
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Ellipse x:Name="ring" Fill="{DynamicResource BackgroundBrush}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" />
                            <Ellipse x:Name="dot" Width="8" Height="8" Fill="{StaticResource OP_Accent}" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ring" Property="Stroke" Value="{StaticResource OP_Accent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ring" Property="Stroke" Value="{StaticResource OP_Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--  Run mode cards  -->
    <Style x:Key="OP_Card" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" Padding="12,10" Background="{DynamicResource TertiaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource OP_Accent}" />
                            <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource OP_Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--  Phase chain steps  -->
    <Style x:Key="OP_Step" TargetType="Border">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}" />
        <Setter Property="Margin" Value="0,2,0,2" />
    </Style>
    <Style x:Key="OP_StepText" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource OP_Muted}" />
    </Style>
    <Style x:Key="OP_Arrow" TargetType="TextBlock">
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource OP_Muted}" />
    </Style>

    <!--  Icons (24 × 24 strokes, from the mockup)  -->
    <Style x:Key="OP_IconPath" TargetType="Path">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>

    <DataTemplate x:Key="NINA.ObservatoryPlanner.UI.PlannerDockableVM_Dockable">
        <!--  narrower than the layout needs: scroll sideways instead of cutting off the right side  -->
        <ScrollViewer Padding="8" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <Grid Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" MinWidth="860">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  ===== status strip =====  -->
            <Border Grid.Row="0" Padding="14,10" Style="{StaticResource OP_Box}">
                <DockPanel>
                    <Button MinWidth="140" Padding="16,6" Command="{Binding RunCommand}" Content="{Binding RunButtonText}" DockPanel.Dock="Right" FontSize="14" ToolTip="{Binding RunButtonTip}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource OP_Primary}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StopShown}" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="{StaticResource OP_Unsafe}" />
                                        <Setter Property="Foreground" Value="{StaticResource OP_Unsafe}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!--  Pause (for the whole run): Pause while running, Pausing while a pause is due, Start sequence while paused  -->
                    <StackPanel Margin="0,0,10,0" VerticalAlignment="Center" DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Click="AddButton_Click" Content="⏸  Pause ▾" IsEnabled="{Binding PauseEnabled}" Style="{StaticResource OP_Small}" ToolTip="{Binding PauseTip}" ToolTipService.ShowOnDisabled="True" Visibility="{Binding PauseShown, Converter={StaticResource OP_BoolVisible}}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="{Binding PauseNowCommand}" Header="Pause now" ToolTip="Stops whatever is running: a frame being taken is dropped; a slew, centering, autofocus, a wait or 1 Begin is interrupted. A meridian flip, the dome shutter and park finish first." />
                                    <MenuItem Command="{Binding PauseAfterFrameCommand}" Header="Pause after this step" ToolTip="The frame or instruction running now finishes first, then it pauses." />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Click="AddButton_Click" Content="⏸  Pausing… ▾" Style="{StaticResource OP_Small}" ToolTip="A pause is due: after the current step, or once a meridian flip, the dome shutter or park has finished" Visibility="{Binding PausingShown, Converter={StaticResource OP_BoolVisible}}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="{Binding PauseNowCommand}" Header="Pause now" ToolTip="Stops whatever is running (a meridian flip, the dome shutter and park finish first)." />
                                    <MenuItem Command="{Binding CancelPauseCommand}" Header="Cancel the pause" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Padding="12,4" Command="{Binding ResumeCommand}" Content="▶  Start sequence" Style="{StaticResource OP_Primary}" ToolTip="Checks the connections and the weather, then continues with the targets and settings as they are now: an interrupted 1 Begin continues from the step it stopped at; on the same target with the mount not moved only guiding restarts; otherwise 2 Start of target runs." Visibility="{Binding IsPaused, Converter={StaticResource OP_BoolVisible}}" />
                    </StackPanel>
                    <!--  4 End steps that failed the last time it ran  -->
                    <Border Margin="0,8,12,0" DockPanel.Dock="Bottom" Style="{StaticResource OP_WarnBox}" Visibility="{Binding EndProblems, Converter={StaticResource OP_TextVisible}}">
                        <DockPanel>
                            <Button Margin="8,0,0,0" Padding="2,0" VerticalAlignment="Top" Command="{Binding DismissEndProblemsCommand}" Content="✕" DockPanel.Dock="Right" Style="{StaticResource OP_Flat}" ToolTip="Close this message" />
                            <TextBlock Style="{StaticResource OP_WarnText}" Text="{Binding EndProblems, StringFormat=⚠ {0}}" />
                        </DockPanel>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Border Padding="10,2" VerticalAlignment="Center" BorderBrush="{Binding PillBrush}" BorderThickness="1" CornerRadius="11">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding PillBrush}" />
                                <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{Binding PillBrush}" Text="{Binding PillText}" />
                            </StackPanel>
                        </Border>
                        <TextBlock MaxWidth="640" Margin="12,0,12,0" VerticalAlignment="Center" Text="{Binding StatusText}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!--  ===== phase chain =====  -->
            <WrapPanel Grid.Row="1" Margin="0,8,0,4">
                <StackPanel Orientation="Horizontal" Visibility="{Binding WithSafety, Converter={StaticResource OP_BoolVisible}}">
                    <Border>
                        <Border.Style>
                            <Style BasedOn="{StaticResource OP_Step}" TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StepWait}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource OP_Accent}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource OP_Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Waiting for safe">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource OP_StepText}" TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StepWait}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource OP_AccentInk}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    </Border>
                    <TextBlock Style="{StaticResource OP_Arrow}" Text="→" />
                </StackPanel>
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource OP_Step}" TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StepBegin}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource OP_Accent}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource OP_Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="1 Begin">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource OP_StepText}" TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StepBegin}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource OP_AccentInk}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <TextBlock Style="{StaticResource OP_Arrow}" Text="→" />
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource OP_Step}" TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StepTarget}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource OP_Accent}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource OP_Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="2 Start of target">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource OP_StepText}" TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StepTarget}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource OP_AccentInk}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <TextBlock Style="{StaticResource OP_Arrow}" Text="→" />
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource OP_Step}" TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StepImaging}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource OP_Accent}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource OP_Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Imaging + 3 triggers">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource OP_StepText}" TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StepImaging}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource OP_AccentInk}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <TextBlock Style="{StaticResource OP_Arrow}" Text="→" />
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource OP_Step}" TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StepEnd}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource OP_Accent}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource OP_Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="4 End">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource OP_StepText}" TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StepEnd}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource OP_AccentInk}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <TextBlock FontSize="16" Foreground="{StaticResource OP_Accent}" Style="{StaticResource OP_Arrow}" Text="↺" ToolTip="Repeats" Visibility="{Binding WithSafety, Converter={StaticResource OP_BoolVisible}}" />
            </WrapPanel>

            <!--  ===== tabs; the gear at the right end selects the options tab =====  -->
            <Grid Grid.Row="2">
                <TabControl SelectedIndex="{Binding SelectedPlannerTab}">
                    <!-- =================== TARGETS =================== -->
                    <TabItem Header="Targets">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="290" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  file bar  -->
                            <Border Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="12,8" Style="{StaticResource OP_Box}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Command="{Binding NewListCommand}" Content="New" Style="{StaticResource OP_Small}" />
                                        <Button Command="{Binding OpenListCommand}" Content="Open…" Style="{StaticResource OP_Small}" />
                                        <Button Command="{Binding SaveListCommand}" Content="Save" Style="{StaticResource OP_Small}" />
                                        <Button Margin="0" Command="{Binding SaveListAsCommand}" Content="Save as…" Style="{StaticResource OP_Small}" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock Margin="0,0,10,0" Style="{StaticResource OP_Label}" Text="TARGET LIST" />
                                        <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{Binding ListName}" />
                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource OP_Hint}" Text="{Binding ListSavedText}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!--  target list  -->
                            <Border Grid.Row="1" Margin="0,0,12,0" Style="{StaticResource OP_Box}">
                                <DockPanel>
                                    <TextBlock Margin="0,0,0,8" DockPanel.Dock="Top" Style="{StaticResource OP_Heading}" Text="TARGETS" />
                                    <StackPanel Margin="0,10,0,0" DockPanel.Dock="Bottom">
                                        <WrapPanel>
                                            <Button Click="AddButton_Click" ToolTip="Add target">
                                                <Button.Style>
                                                    <Style BasedOn="{StaticResource OP_Icon}" TargetType="Button">
                                                        <Setter Property="Background" Value="{StaticResource OP_Accent}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource OP_Accent}" />
                                                        <Setter Property="Foreground" Value="{StaticResource OP_AccentInk}" />
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M12,5 V19 M5,12 H19" Style="{StaticResource OP_IconPath}" />
                                                    <Path Width="9" Height="9" Margin="2,0,0,0" Data="M2,3.5 L5,6.5 L8,3.5" Style="{StaticResource OP_IconPath}" />
                                                </StackPanel>
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Command="{Binding AddEmptyCommand}" Header="Empty target" ToolTip="Opens Target Settings to enter its name and coordinates" />
                                                        <MenuItem Command="{Binding AddFromFramingCommand}" Header="From Framing Assistant" ToolTip="Name, coordinates and rotation of the framed target" />
                                                        <MenuItem Command="{Binding AddMosaicCommand}" Header="Mosaic from Framing Assistant" ToolTip="One target per mosaic panel" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                            <Button Command="{Binding DuplicateCommand}" Style="{StaticResource OP_Icon}" ToolTip="Duplicate target">
                                                <Path Data="M10,8 H18 A2,2 0 0 1 20,10 V18 A2,2 0 0 1 18,20 H10 A2,2 0 0 1 8,18 V10 A2,2 0 0 1 10,8 Z M16,8 V6 A2,2 0 0 0 14,4 H6 A2,2 0 0 0 4,6 V14 A2,2 0 0 0 6,16 H8" Style="{StaticResource OP_IconPath}" />
                                            </Button>
                                            <Button Command="{Binding MoveUpCommand}" Style="{StaticResource OP_Icon}" ToolTip="Move up (image earlier)">
                                                <Path Data="M12,19 V5 M6,11 L12,5 L18,11" Style="{StaticResource OP_IconPath}" />
                                            </Button>
                                            <Button Command="{Binding MoveDownCommand}" Style="{StaticResource OP_Icon}" ToolTip="Move down (image later)">
                                                <Path Data="M12,5 V19 M6,13 L12,19 L18,13" Style="{StaticResource OP_IconPath}" />
                                            </Button>
                                            <Rectangle Width="1" Height="22" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource BorderBrush}" />
                                            <Button Command="{Binding DeleteCommand}" Style="{StaticResource OP_Icon}" ToolTip="Delete target">
                                                <Path Data="M4,7 H20 M9,7 V4 H15 V7 M6,7 L7,20 H17 L18,7 M10,11 V17 M14,11 V17" Style="{StaticResource OP_IconPath}" />
                                            </Button>
                                        </WrapPanel>
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource OP_Hint}" Text="Checked targets are imaged top to bottom. You can edit this list while the loop runs; it is read again each time imaging starts or resumes." />
                                    </StackPanel>
                                    <ListBox
                                        MaxHeight="212"
                                        local:WheelBubbling.AtEnds="True"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ItemsSource="{Binding Targets}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        SelectedItem="{Binding SelectedTarget}">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Margin" Value="0,0,0,4" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="bd" Padding="8,6" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource TertiaryBackgroundBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource TertiaryBackgroundBrush}" />
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource OP_Accent}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <CheckBox Margin="0,0,8,0" IsChecked="{Binding Enabled}" Style="{StaticResource OP_Check}" ToolTip="Include this target" />
                                                    <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource OP_TargetState}">
                                                                <Binding />
                                                                <Binding Path="DataContext.ListState" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                                                <Binding Path="Enabled" />
                                                                <Binding Path="IsComplete" />
                                                                <Binding Path="TotalFrames" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                        <TextBlock.Foreground>
                                                            <MultiBinding Converter="{StaticResource OP_TargetState}" ConverterParameter="brush">
                                                                <Binding />
                                                                <Binding Path="DataContext.ListState" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                                                <Binding Path="Enabled" />
                                                                <Binding Path="IsComplete" />
                                                                <Binding Path="TotalFrames" />
                                                            </MultiBinding>
                                                        </TextBlock.Foreground>
                                                        <TextBlock.ToolTip>
                                                            <MultiBinding Converter="{StaticResource OP_TargetState}" ConverterParameter="tip">
                                                                <Binding />
                                                                <Binding Path="DataContext.ListState" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                                                <Binding Path="Enabled" />
                                                                <Binding Path="IsComplete" />
                                                                <Binding Path="TotalFrames" />
                                                            </MultiBinding>
                                                        </TextBlock.ToolTip>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="2" Margin="6,0" VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="12" Opacity="0.7" Style="{StaticResource OP_Mono}" Text="{Binding Percent, StringFormat={}{0:0}%}" />
                                                    <Button Grid.Column="4" Margin="6,0,0,0" Command="{Binding DataContext.TargetSettingsCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Content="⚙" FontSize="15" Style="{StaticResource OP_Flat}" ToolTip="Target settings" />
                                                    <ProgressBar Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Height="3" Margin="6,4,0,0" Maximum="100" Value="{Binding Percent, Mode=OneWay}">
                                                        <ProgressBar.Style>
                                                            <Style TargetType="ProgressBar">
                                                                <Setter Property="Foreground" Value="{StaticResource OP_Accent}" />
                                                                <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
                                                                <Setter Property="BorderThickness" Value="0" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource OP_Safe}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ProgressBar.Style>
                                                    </ProgressBar>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <!--  selected target  -->
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource OP_Box}">
                                <Grid>
                                    <TextBlock Opacity="0.7" Text="Add a target to get started." Visibility="{Binding HasSelection, Converter={StaticResource OP_BoolCollapsed}}" />
                                    <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource OP_BoolVisible}}">
                                        <!--  header  -->
                                        <DockPanel Margin="0,0,0,10" DockPanel.Dock="Top">
                                            <StackPanel VerticalAlignment="Top" DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Command="{Binding AutofocusCommand}" Content="{Binding AutofocusText}" Style="{StaticResource OP_Small}" ToolTip="Run autofocus before the next frame. The frame being taken now finishes first. Available while a target is imaging." />
                                                <Button Margin="0" Command="{Binding TargetSettingsCommand}" CommandParameter="{Binding SelectedTarget}" Content="⚙  Target settings" Style="{StaticResource OP_Small}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock FontSize="21" FontWeight="Bold" Text="{Binding SelectedTarget.Name}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,2,0,4" FontSize="12.5" Opacity="0.7" Style="{StaticResource OP_Mono}" Text="{Binding CoordinatesText}" />
                                                <ItemsControl ItemsSource="{Binding TargetChips}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource OP_Chip}">
                                                                <TextBlock FontSize="12" Text="{Binding}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DockPanel>

                                        <!--  exposure settings  -->
                                        <WrapPanel Margin="0,0,0,6" DockPanel.Dock="Top">
                                            <TextBlock Margin="0,0,16,0" Style="{StaticResource OP_Label}" Text="EXPOSURES" />
                                            <StackPanel Margin="0,2,16,2" Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" Opacity="0.75" Text="⧗ Delay first " />
                                                <TextBox Width="52" Text="{Binding SelectedTarget.DelayFirst}" />
                                                <TextBlock VerticalAlignment="Center" Text=" s" />
                                            </StackPanel>
                                            <StackPanel Margin="0,2,16,2" Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" Opacity="0.75" Text="⧗ Delay between " />
                                                <TextBox Width="52" Text="{Binding SelectedTarget.DelayBetween}" />
                                                <TextBlock VerticalAlignment="Center" Text=" s" />
                                            </StackPanel>
                                            <StackPanel Margin="0,2" Orientation="Horizontal">
                                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Opacity="0.75" Text="Order:" />
                                                <RadioButton Content="Rotate through filters" GroupName="OP_TargetOrder" IsChecked="{Binding SelectedTarget.Order, Converter={StaticResource OP_EnumBool}, ConverterParameter=RotateThroughFilters}" Style="{StaticResource OP_Radio}" />
                                                <RadioButton Content="Finish each row first" GroupName="OP_TargetOrder" IsChecked="{Binding SelectedTarget.Order, Converter={StaticResource OP_EnumBool}, ConverterParameter=FinishEachRowFirst}" Style="{StaticResource OP_Radio}" />
                                            </StackPanel>
                                        </WrapPanel>

                                        <!--  footer  -->
                                        <StackPanel Margin="0,8,0,0" DockPanel.Dock="Bottom">
                                            <WrapPanel>
                                                <Button Command="{Binding AddExposureCommand}" Content="＋ Add exposure" Style="{StaticResource OP_Small}" />
                                                <Button Command="{Binding ResetProgressCommand}" Content="Reset progress" Style="{StaticResource OP_Small}" />
                                                <TextBlock Margin="6,0" VerticalAlignment="Center" Opacity="0.7" Text="{Binding RemainingText}" />
                                            </WrapPanel>
                                            <Border Style="{StaticResource OP_WarnBox}" Visibility="{Binding RotateAfWarning, Converter={StaticResource OP_TextVisible}}">
                                                <DockPanel>
                                                    <Button Margin="8,0,0,0" Padding="2,0" VerticalAlignment="Top" Command="{Binding DismissWarningCommand}" CommandParameter="{Binding RotateAfWarning}" Content="✕" DockPanel.Dock="Right" Style="{StaticResource OP_Flat}" ToolTip="Close this message" />
                                                    <TextBlock Style="{StaticResource OP_WarnText}" Text="{Binding RotateAfWarning, StringFormat=⚠ {0}}" />
                                                </DockPanel>
                                            </Border>
                                        </StackPanel>

                                        <!--  exposure rows: about four visible, then it scrolls  -->
                                        <DataGrid
                                            MaxHeight="214"
                                            local:WheelBubbling.AtEnds="True"
                                            AlternationCount="1000"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            CanUserDeleteRows="False"
                                            CanUserReorderColumns="False"
                                            CanUserSortColumns="False"
                                            HeadersVisibility="Column"
                                            ItemsSource="{Binding SelectedTarget.Exposures}"
                                            SelectionUnit="Cell">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="Priority">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                                <!--  ▶ marks the row being imaged now  -->
                                                                <TextBlock Width="12" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource OP_Accent}" Text="▶" ToolTip="Being imaged now">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Hidden" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Width="18" Margin="0,0,4,0" VerticalAlignment="Center" Opacity="0.7" Style="{StaticResource OP_Mono}" Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource OP_PlusOne}}" TextAlignment="Right" />
                                                                <Button Width="24" MinHeight="22" Padding="0" Margin="0,0,2,0" Command="{Binding DataContext.ExposureUpCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="▲" FontSize="10" Style="{StaticResource OP_Btn}" ToolTip="Move up (higher priority)" />
                                                                <Button Width="24" MinHeight="22" Padding="0" Command="{Binding DataContext.ExposureDownCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="▼" FontSize="10" Style="{StaticResource OP_Btn}" ToolTip="Move down (lower priority)" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Run">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <CheckBox HorizontalAlignment="Center" IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OP_Check}" ToolTip="Run this row" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Width="86" Header="Type">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <ComboBox DisplayMemberPath="Label" ItemsSource="{Binding DataContext.ExposureTypeChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedValue="{Binding Type}" SelectedValuePath="Value" ToolTip="Image type. The camera's gain is used." />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Width="90" Header="Filter">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <ComboBox IsEditable="True" ItemsSource="{Binding DataContext.FilterChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}" Text="{Binding Filter, UpdateSourceTrigger=LostFocus}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Width="88" Header="Exposure (s)">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding ExposureTime, UpdateSourceTrigger=LostFocus}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Width="74" Header="Binning">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <ComboBox ItemsSource="{Binding DataContext.BinningChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding Binning}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Width="62" Header="Repeat">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding Count, UpdateSourceTrigger=LostFocus}" ToolTip="How many frames of this row to take" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Width="*" MinWidth="110" Header="Progress">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <ToggleButton x:Name="progressButton" HorizontalContentAlignment="Stretch" Style="{StaticResource OP_Flat}" ToolTip="Click to change the captured frames">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <ProgressBar Height="8" MinWidth="40" Maximum="{Binding Count, Mode=OneWay}" Value="{Binding Done, Mode=OneWay}">
                                                                            <ProgressBar.Style>
                                                                                <Style TargetType="ProgressBar">
                                                                                    <Setter Property="Foreground" Value="{StaticResource OP_Accent}" />
                                                                                    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
                                                                                    <Setter Property="BorderThickness" Value="0" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Remaining}" Value="0">
                                                                                            <Setter Property="Foreground" Value="{StaticResource OP_Safe}" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </ProgressBar.Style>
                                                                        </ProgressBar>
                                                                        <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Style="{StaticResource OP_Mono}">
                                                                            <Run Text="{Binding Done, Mode=OneWay}" /><Run Text="/" /><Run Text="{Binding Count, Mode=OneWay}" />
                                                                        </TextBlock>
                                                                    </Grid>
                                                                </ToggleButton>
                                                                <Popup AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=progressButton}" Placement="Bottom" PlacementTarget="{Binding ElementName=progressButton}" StaysOpen="False">
                                                                    <Border Padding="10,8" Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource OP_Accent}" BorderThickness="1" CornerRadius="6">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Captured frames:" />
                                                                            <TextBox Width="70" Text="{Binding Done, UpdateSourceTrigger=PropertyChanged}" />
                                                                            <Button Margin="8,0,0,0" Click="ProgressOk_Click" Content="OK" Style="{StaticResource OP_Primary}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Popup>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Command="{Binding DataContext.DeleteExposureCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="✕" Style="{StaticResource OP_Flat}" ToolTip="Delete row" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- =================== EQUIPMENT & SAFETY =================== -->
                    <TabItem Header="Equipment &amp; Safety">
                        <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!--  file bar  -->
                                <Border Margin="0,0,0,10" Padding="12,8" Style="{StaticResource OP_Box}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Command="{Binding RefreshStagesCommand}" Content="↻ Refresh" Style="{StaticResource OP_Small}" ToolTip="Read the four stages again from the Advanced Sequencer (it also happens every few seconds)" />
                                            <Button Command="{Binding OpenWorkflowCommand}" Content="Open…" Style="{StaticResource OP_Small}" />
                                            <Button Command="{Binding SaveWorkflowCommand}" Content="Save" Style="{StaticResource OP_Small}" />
                                            <Button Margin="0" Command="{Binding SaveWorkflowAsCommand}" Content="Save as…" Style="{StaticResource OP_Small}" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock Margin="0,0,10,0" Style="{StaticResource OP_Label}" Text="EQUIPMENT &amp; SAFETY" />
                                            <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{Binding WorkflowName}" />
                                            <TextBlock VerticalAlignment="Center" Style="{StaticResource OP_Hint}" Text="{Binding WorkflowSavedText}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!--  how the night runs  -->
                                <Border Margin="0,0,0,12" Style="{StaticResource OP_Box}">
                                    <StackPanel>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding ModeSummary}" />
                                                <TextBlock FontSize="12" Opacity="0.7" Text="  ·  " />
                                                <Button Command="{Binding GoOptionsCommand}" Content="change in ⚙ Options" FontSize="12" Style="{StaticResource OP_Link}" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource OP_Heading}" Text="HOW THE NIGHT RUNS" />
                                        </DockPanel>
                                        <WrapPanel Margin="0,10,0,6">
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding WithSafety, Converter={StaticResource OP_BoolVisible}}">
                                                <Border Padding="10,5" BorderBrush="{StaticResource OP_Muted}" BorderThickness="1" CornerRadius="6">
                                                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource OP_Muted}" Text="Wait for safe" />
                                                </Border>
                                                <TextBlock Style="{StaticResource OP_Arrow}" Text="→" />
                                            </StackPanel>
                                            <Border Padding="8,4" Background="{DynamicResource TertiaryBackgroundBrush}" BorderBrush="{StaticResource OP_Safe}" BorderThickness="1" CornerRadius="6">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="18" Height="18" Margin="0,0,6,0" Background="{StaticResource OP_Safe}" CornerRadius="9"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OP_AccentInk}" Text="1" /></Border>
                                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Begin" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Style="{StaticResource OP_Arrow}" Text="→" />
                                            <Border Padding="8,4" Background="{DynamicResource TertiaryBackgroundBrush}" BorderBrush="{StaticResource OP_Info}" BorderThickness="1" CornerRadius="6">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="18" Height="18" Margin="0,0,6,0" Background="{StaticResource OP_Info}" CornerRadius="9"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OP_AccentInk}" Text="2" /></Border>
                                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Start of target" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Style="{StaticResource OP_Arrow}" Text="→" />
                                            <Border Padding="8,4" Background="{DynamicResource TertiaryBackgroundBrush}" BorderBrush="{StaticResource OP_Accent}" BorderThickness="1" CornerRadius="6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Imaging + " />
                                                    <Border Width="18" Height="18" Margin="2,0,4,0" Background="{StaticResource OP_Accent}" CornerRadius="9"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OP_AccentInk}" Text="3" /></Border>
                                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="triggers" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Style="{StaticResource OP_Arrow}" Text="→" />
                                            <Border Padding="8,4" Background="{DynamicResource TertiaryBackgroundBrush}" BorderBrush="{StaticResource OP_Unsafe}" BorderThickness="1" CornerRadius="6">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="18" Height="18" Margin="0,0,6,0" Background="{StaticResource OP_Unsafe}" CornerRadius="9"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OP_AccentInk}" Text="4" /></Border>
                                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="End" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock FontSize="18" Foreground="{StaticResource OP_Accent}" Style="{StaticResource OP_Arrow}" Text="↺" ToolTip="Repeats" Visibility="{Binding WithSafety, Converter={StaticResource OP_BoolVisible}}" />
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource OP_Hint}" Text="{Binding CycleHint}" />
                                        <Border Style="{StaticResource OP_WarnBox}" Visibility="{Binding NoSafetyWarningShown, Converter={StaticResource OP_BoolVisible}}">
                                            <DockPanel>
                                                <Button Margin="8,0,0,0" Padding="2,0" VerticalAlignment="Top" Command="{Binding DismissWarningCommand}" CommandParameter="no-safety" Content="✕" DockPanel.Dock="Right" Style="{StaticResource OP_Flat}" ToolTip="Close this message" />
                                                <TextBlock Style="{StaticResource OP_WarnText}" Text="⚠ No safety monitor: nothing closes the dome or stops imaging for rain or clouds. Stay nearby while it runs." />
                                            </DockPanel>
                                        </Border>
                                        <DockPanel Margin="0,10,0,0">
                                            <Button VerticalAlignment="Center" Command="{Binding LoadDefaultWorkflowCommand}" Content="Load a default workflow…" DockPanel.Dock="Right" Style="{StaticResource OP_Small}" />
                                            <WrapPanel VerticalAlignment="Center">
                                                <TextBlock Margin="0,0,8,0" Style="{StaticResource OP_Label}" Text="KEEP CONNECTED" />
                                                <ItemsControl ItemsSource="{Binding KeepChips}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource OP_Chip}">
                                                                <TextBlock FontSize="12" Text="{Binding}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Margin="2,0,0,0" Command="{Binding GoOptionsCommand}" Content="edit" FontSize="12" Style="{StaticResource OP_Link}" />
                                            </WrapPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!--  the four stages, equal heights  -->
                                <ItemsControl ItemsSource="{Binding Stages}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,12,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Style="{StaticResource OP_Box}">
                                                <Grid>
                                                    <Border Height="3" Margin="-12,-12,-12,0" VerticalAlignment="Top" Background="{Binding Brush}" CornerRadius="6,6,0,0" />
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Top">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="22" Height="22" Margin="0,0,8,0" Background="{Binding Brush}" CornerRadius="11">
                                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource OP_AccentInk}" Text="{Binding Number}" />
                                                                </Border>
                                                                <TextBlock VerticalAlignment="Center" Style="{StaticResource OP_Heading}" Text="{Binding Title}" />
                                                            </StackPanel>
                                                            <TextBlock Margin="0,6,0,8" Style="{StaticResource OP_Hint}" Text="{Binding Hint}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,8,0,0" DockPanel.Dock="Bottom">
                                                            <ItemsControl ItemsSource="{Binding Warnings}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Style="{StaticResource OP_WarnBox}">
                                                                            <DockPanel>
                                                                                <Button Margin="8,0,0,0" Padding="2,0" VerticalAlignment="Top" Command="{Binding DataContext.DismissWarningCommand, RelativeSource={RelativeSource AncestorType=TabControl}}" CommandParameter="{Binding}" Content="✕" DockPanel.Dock="Right" Style="{StaticResource OP_Flat}" ToolTip="Close this message" />
                                                                                <TextBlock Style="{StaticResource OP_WarnText}" Text="{Binding StringFormat=⚠ {0}}" />
                                                                            </DockPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Button Margin="0,8,0,0" HorizontalAlignment="Left" Command="{Binding DataContext.EditInSequencerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}" Content="✎  Edit in Advanced Sequencer" Style="{StaticResource OP_Small}" />
                                                        </StackPanel>
                                                        <Grid>
                                                            <TextBlock Opacity="0.7" Text="{Binding EmptyText}" TextWrapping="Wrap" Visibility="{Binding EmptyText, Converter={StaticResource OP_TextVisible}}" />
                                                            <ScrollViewer MaxHeight="230" local:WheelBubbling.AtEnds="True" VerticalScrollBarVisibility="Auto">
                                                                <ItemsControl ItemsSource="{Binding Lines}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Padding="0,3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="22" />
                                                                                        <ColumnDefinition Width="92" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock FontSize="11" Opacity="0.6" Style="{StaticResource OP_Mono}" Text="{Binding Number}" />
                                                                                    <TextBlock Grid.Column="1" Margin="0,0,8,0" FontSize="11" Opacity="0.6" Style="{StaticResource OP_Mono}" Text="{Binding Category}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Category}" />
                                                                                    <TextBlock Grid.Column="2" FontSize="13" TextWrapping="Wrap">
                                                                                        <Run Text="{Binding Name, Mode=OneWay}" /><Run Foreground="{StaticResource OP_Muted}" Text="{Binding SummaryText, Mode=OneWay}" />
                                                                                    </TextBlock>
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>
                                                        </Grid>
                                                    </DockPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- =================== OPTIONS (opened with the gear) =================== -->
                    <TabItem Header="Options" Visibility="Collapsed">
                        <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="660" HorizontalAlignment="Left">
                                <Border Margin="0,0,0,12" Style="{StaticResource OP_Box}">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,8" Style="{StaticResource OP_Heading}" Text="RUN MODE" />
                                        <UniformGrid Columns="2">
                                            <RadioButton GroupName="OP_Mode" IsChecked="{Binding WithSafety, Mode=TwoWay}" Style="{StaticResource OP_Card}">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="Run with safety" />
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource OP_Hint}" Text="You have a safety monitor. Runs every night: starts when it is safe, shuts down when unsafe, resumes when safe again." />
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton Margin="0" GroupName="OP_Mode" IsChecked="{Binding WithoutSafety, Mode=TwoWay}" Style="{StaticResource OP_Card}">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="Run without safety" />
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource OP_Hint}" Text="No safety monitor. Each Run goes through your targets once, then stops. Stay nearby for weather." />
                                                </StackPanel>
                                            </RadioButton>
                                        </UniformGrid>
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource OP_Hint}" Text="Pick the one that matches your setup; you normally set this once. Changing it offers to load the default workflow for that mode." />
                                        <CheckBox Margin="0,12,0,0" Content="Start the run when NINA starts (the last workflow and target list are reopened first)" IsChecked="{Binding Options.AutoStartOnLaunch}" Style="{StaticResource OP_Check}" />
                                        <TextBlock Margin="23,2,0,0" Style="{StaticResource OP_Hint}" Text="For unattended restarts, e.g. after a power cut or a Windows update. A sequence that was paused stays paused." />
                                        <StackPanel Margin="0,12,0,0" Visibility="{Binding WithSafety, Converter={StaticResource OP_BoolVisible}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" Text="When it becomes safe, wait " />
                                                <TextBox Width="60" Text="{Binding Options.SafeDelaySeconds}" />
                                                <TextBlock VerticalAlignment="Center" Text=" s before 1 Begin" />
                                            </StackPanel>
                                            <TextBlock Margin="0,2,0,0" Style="{StaticResource OP_Hint}" Text="It must stay safe for the whole wait; if it turns unsafe, the wait starts again the next time it is safe. 0 starts at once." />
                                        </StackPanel>
                                        <CheckBox Margin="0,12,0,0" Content="Autofocus before the first frame after 1 Begin, and after a weather close-up" IsChecked="{Binding Options.AutofocusAfterBegin}" Style="{StaticResource OP_Check}" />
                                        <TextBlock Margin="23,2,0,0" Style="{StaticResource OP_Hint}" Text="1 Begin runs after the equipment was off (the start of the night, after clouds), so the focus is found again before the first light frame, once the target is centred and guiding. Filter changes are handled by &quot;AF after filter change (planner)&quot; in 3 While imaging." />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,0,0,12" Style="{StaticResource OP_Box}">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,6" Style="{StaticResource OP_Heading}" Text="WEATHER" />
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox VerticalAlignment="Center" FontWeight="SemiBold" Content="Night: image only while the Sun is below" IsChecked="{Binding Options.NightLimitEnabled}" Style="{StaticResource OP_Check}" />
                                            <ComboBox Width="230" Margin="8,0,0,0" DisplayMemberPath="Label" IsEnabled="{Binding Options.NightLimitEnabled}" ItemsSource="{Binding SunLimitChoices}" SelectedValue="{Binding Options.NightLimit}" SelectedValuePath="Value" />
                                        </StackPanel>
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource OP_Hint}" Text="This defines the night for choosing targets, and is what keeps the planner from imaging into daylight:" />
                                        <TextBlock Margin="10,2,0,0" Style="{StaticResource OP_Hint}" Text="• Evening: no target starts before the Sun is below the chosen twilight, even if the target's own start time or altitude has been reached." />
                                        <TextBlock Margin="10,2,0,0" Style="{StaticResource OP_Hint}" Text="• Morning: no frame starts that would end after the Sun rises above it. When no target can run any more, the night is finished and 4 End runs." />
                                        <TextBlock Margin="10,2,0,0" Style="{StaticResource OP_Hint}" Text="• It does not start 1 Begin: with a safety monitor 1 Begin starts when it reports safe; without one the built-in workflows wait for astronomical dusk (Wait for Time in 1 Begin)." />
                                        <TextBlock Margin="10,2,0,0" Style="{StaticResource OP_Hint}" Text="• Off: the Sun is not considered; targets are limited by their own start and end settings, the horizon and the safety monitor." />
                                        <StackPanel Margin="0,12,0,0" Visibility="{Binding WithSafety, Converter={StaticResource OP_BoolVisible}}">
                                        <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="When it turns unsafe during the night:" />
                                        <RadioButton Content="Run 4 End (full shutdown: warm the camera, power off)" GroupName="OP_Unsafe" IsChecked="{Binding Options.UnsafeAction, Converter={StaticResource OP_EnumBool}, ConverterParameter=RunEnd}" Style="{StaticResource OP_Radio}" />
                                        <RadioButton Content="Close up and wait: stop guiding, park, close the dome; power, connections and camera cooling stay on" GroupName="OP_Unsafe" IsChecked="{Binding Options.UnsafeAction, Converter={StaticResource OP_EnumBool}, ConverterParameter=CloseUpAndWait}" Style="{StaticResource OP_Radio}" />
                                        <StackPanel Margin="23,6,0,0" IsEnabled="{Binding CloseUpOnUnsafe}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" Text="Run 4 End if it is still unsafe after " />
                                                <TextBox Width="52" Text="{Binding Options.CloseUpMaxHours}" />
                                                <TextBlock VerticalAlignment="Center" Text=" h, or at " />
                                                <ComboBox Width="230" DisplayMemberPath="Label" ItemsSource="{Binding SunLimitChoices}" SelectedValue="{Binding Options.CloseUpEnd}" SelectedValuePath="Value" />
                                                <TextBlock VerticalAlignment="Center" Text=", whichever comes first" />
                                            </StackPanel>
                                            <TextBlock Margin="0,6,0,0" Style="{StaticResource OP_Hint}" Text="The close-up also ends when nothing is left to image tonight. The morning time chosen here is separate from the Night setting above. When it is safe again (after the wait after safe): open the dome, unpark, autofocus before the first frame (with the autofocus option on), then 2 Start of target. Close-up starts once 1 Begin has finished; unsafe during 1 Begin runs 4 End. If park or closing the dome fails, 4 End runs at once. Stop while closed up runs 4 End." />
                                        </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,0,0,12" Style="{StaticResource OP_Box}">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,6" Style="{StaticResource OP_Heading}" Text="GUIDE STAR LOST" />
                                        <CheckBox Content="Watch the guide star during light frames (PHD2)" IsChecked="{Binding Options.GuideLostWatch}" Style="{StaticResource OP_Check}" />
                                        <StackPanel Margin="23,6,0,0" IsEnabled="{Binding Options.GuideLostWatch}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" Text="Wait up to " />
                                                <TextBox Width="60" Text="{Binding Options.GuideLostWaitSeconds}" />
                                                <TextBlock VerticalAlignment="Center" Text=" s for PHD2 to find the star again" />
                                            </StackPanel>
                                            <TextBlock Margin="0,8,0,4" Text="If it doesn't come back:" />
                                            <RadioButton Content="Run 4 End and stop for the night" GroupName="OP_GuideLost" IsChecked="{Binding Options.GuideLostAction, Converter={StaticResource OP_EnumBool}, ConverterParameter=StopForNight}" Style="{StaticResource OP_Radio}" />
                                            <RadioButton Content="Go to the next target (4 End runs if there is none)" GroupName="OP_GuideLost" IsChecked="{Binding Options.GuideLostAction, Converter={StaticResource OP_EnumBool}, ConverterParameter=NextTarget}" Style="{StaticResource OP_Radio}" />
                                            <TextBlock Margin="0,6,0,0" Style="{StaticResource OP_Hint}" Text="A loss shorter than 10 s is ignored. A longer one drops the frame being taken (it is taken again). The wait counts from when the star was lost. Unsafe weather during the wait is handled as usual: 4 End, then wait for safe." />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,0,0,12" Style="{StaticResource OP_Box}">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,6" Style="{StaticResource OP_Heading}" Text="GUIDING ERROR" />
                                        <CheckBox Content="Check the guiding error before and during light frames (PHD2)" IsChecked="{Binding Options.GuidingCheck}" Style="{StaticResource OP_Check}" />
                                        <StackPanel Margin="23,6,0,0" IsEnabled="{Binding Options.GuidingCheck}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" Text="Limit " />
                                                <TextBox Width="60" Text="{Binding Options.GuidingLimitPixels}" />
                                                <TextBlock VerticalAlignment="Center" Text=" px (guide camera pixels)" />
                                            </StackPanel>
                                            <TextBlock Margin="0,2,0,0" Style="{StaticResource OP_Hint}" Text="{Binding GuidingLimitArcsec}" />
                                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" Text="Before a frame, wait up to " />
                                                <TextBox Width="60" Text="{Binding Options.GuidingCheckWaitSeconds}" />
                                                <TextBlock VerticalAlignment="Center" Text=" s for the error to come below the limit, then start anyway" />
                                            </StackPanel>
                                            <TextBlock Margin="0,6,0,0" Style="{StaticResource OP_Hint}" Text="The error is the total (RA and Dec) over the last 10 guide steps; dithers are not counted. A frame is restarted when the error stays above the limit for 10 s. A frame started because the wait ran out is not restarted." />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,0,0,12" Style="{StaticResource OP_Box}">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,6" Style="{StaticResource OP_Heading}" Text="WHEN DISCONNECTING" />
                                        <CheckBox Content="Close PHD2 when the guider is disconnected" IsChecked="{Binding Options.CloseGuiderAppOnDisconnect}" Style="{StaticResource OP_Check}" />
                                        <TextBlock Margin="23,2,0,0" Style="{StaticResource OP_Hint}" Text="PHD2 disconnects its own guide camera and mount, then closes. NINA's disconnect alone leaves PHD2 open with its equipment connected." />
                                        <CheckBox Margin="0,10,0,0" Content="Close the mount software when the mount is disconnected" IsChecked="{Binding Options.CloseMountAppOnDisconnect}" Style="{StaticResource OP_Check}" />
                                        <TextBlock Margin="23,2,0,0" Style="{StaticResource OP_Hint}" Text="For an ASCOM mount program such as GS Server: PHD2 lets go of the mount first, then the program closes by itself. If it is still open after 30 s (another program uses it), it is left open and a note is shown." />
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource OP_Hint}" Text="Both work with Disconnect Equipment (Guider, Mount) and Disconnect All Equipment wherever they are in the sequence, while NINA's sequence runs. Disconnecting by hand in NINA's Equipment tab is not affected." />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,0,0,12" Style="{StaticResource OP_Box}">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,6" Style="{StaticResource OP_Heading}" Text="KEEP CONNECTED" />
                                        <TextBlock Style="{StaticResource OP_Hint}" Text="These devices are connected when you press Run and stay connected the whole time, also after 4 End, so the planner can always watch the weather, switch power and close the dome. Power them outside any switch you turn off in 4 End." />
                                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding KeepItems}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="3" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Margin="0,4" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding Locked, Converter={x:Static local:InvertBool.Instance}}" Style="{StaticResource OP_Check}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Label}" />
                                                            <TextBlock FontSize="11" Opacity="0.65" Text="{Binding Note}" Visibility="{Binding Note, Converter={StaticResource OP_TextVisible}}" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,0,0,12" Style="{StaticResource OP_Box}">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,8" Style="{StaticResource OP_Heading}" Text="DEFAULTS FOR NEW TARGETS" />
                                        <UniformGrid Columns="2">
                                            <Border Margin="0,0,8,0" Padding="10,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                                <StackPanel>
                                                    <TextBlock Margin="0,0,0,6" Style="{StaticResource OP_Label}" Text="DELAY" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Width="110" VerticalAlignment="Center" Text="⧗ Delay first" />
                                                        <TextBox Width="60" Text="{Binding Options.DefaultDelayFirst}" />
                                                        <TextBlock VerticalAlignment="Center" Text=" s" />
                                                    </StackPanel>
                                                    <TextBlock Margin="0,2,0,8" Style="{StaticResource OP_Hint}" Text="Wait before the first exposure each time a target starts or resumes, e.g. to let the mount settle after centering." />
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Width="110" VerticalAlignment="Center" Text="⧗ Delay between" />
                                                        <TextBox Width="60" Text="{Binding Options.DefaultDelayBetween}" />
                                                        <TextBlock VerticalAlignment="Center" Text=" s" />
                                                    </StackPanel>
                                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource OP_Hint}" Text="Wait between each exposure." />
                                                </StackPanel>
                                            </Border>
                                            <Border Padding="10,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                                <StackPanel>
                                                    <TextBlock Margin="0,0,0,6" Style="{StaticResource OP_Label}" Text="EXPOSURE ORDER" />
                                                    <RadioButton Content="Rotate through filters" GroupName="OP_DefaultOrder" IsChecked="{Binding Options.DefaultOrder, Converter={StaticResource OP_EnumBool}, ConverterParameter=RotateThroughFilters}" Style="{StaticResource OP_Radio}" />
                                                    <RadioButton Content="Finish each row first" GroupName="OP_DefaultOrder" IsChecked="{Binding Options.DefaultOrder, Converter={StaticResource OP_EnumBool}, ConverterParameter=FinishEachRowFirst}" Style="{StaticResource OP_Radio}" />
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource OP_Hint}" Text="Rotate takes one frame per row in turn (Ha, OIII, SII, Ha…). Finish completes each row before moving to the next." />
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource OP_Hint}" Text="Used when you add a target. Each target can still change its own values on the Targets tab." />
                                        <Button Margin="0,8,0,0" HorizontalAlignment="Left" Command="{Binding ApplyDefaultsToAllCommand}" Content="Apply these to all existing targets" Style="{StaticResource OP_Small}" />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,0,0,12" Style="{StaticResource OP_Box}">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,8" Style="{StaticResource OP_Heading}" Text="BETWEEN TARGETS" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center" Text="If the next target starts more than " />
                                            <TextBox Width="52" Text="{Binding Options.GapMinutes}" />
                                            <TextBlock VerticalAlignment="Center" Text=" min later:" />
                                        </StackPanel>
                                        <UniformGrid Margin="0,8,0,0" Columns="2">
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Margin="0,0,0,4" FontSize="12" Opacity="0.7" Text="Mount during the wait" />
                                                <ComboBox DisplayMemberPath="Label" ItemsSource="{Binding GapMountChoices}" SelectedValue="{Binding Options.GapMount}" SelectedValuePath="Value" />
                                            </StackPanel>
                                            <StackPanel IsEnabled="{Binding GapCloseDomeVisible}">
                                                <TextBlock Margin="0,0,0,4" FontSize="12" Opacity="0.7" Text="Close dome during the wait" />
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding Options.GapCloseDome}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </UniformGrid>
                                        <Border Margin="0,10,0,0" Padding="10,8" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Margin="0,4,12,4" VerticalAlignment="Center" FontSize="12" Opacity="0.7" Text="When the wait starts" />
                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding GapWaitSteps}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Margin="0,2" Style="{StaticResource OP_Chip}">
                                                                    <TextBlock FontSize="12" Text="{Binding Text}" />
                                                                </Border>
                                                                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Opacity="0.6" Text="→" Visibility="{Binding HasNext, Converter={StaticResource OP_BoolVisible}}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Grid.Row="1" Margin="0,4,12,4" VerticalAlignment="Center" FontSize="12" Opacity="0.7" Text="{Binding GapResumeLabel}" />
                                                <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding GapResumeSteps}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Margin="0,2" Style="{StaticResource OP_Chip}">
                                                                    <TextBlock FontSize="12" Text="{Binding Text}" />
                                                                </Border>
                                                                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Opacity="0.6" Text="→" Visibility="{Binding HasNext, Converter={StaticResource OP_BoolVisible}}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource OP_Hint}" Text="{Binding GapHint}" />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,0,0,12" Style="{StaticResource OP_Box}">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,8" Style="{StaticResource OP_Heading}" Text="CONFIRMATIONS" />
                                        <CheckBox Content="Ask before deleting a target" IsChecked="{Binding Options.ConfirmDeleteTarget}" Style="{StaticResource OP_Check}" />
                                        <CheckBox Margin="0,6,0,0" Content="Ask before deleting an exposure row" IsChecked="{Binding Options.ConfirmDeleteExposure}" Style="{StaticResource OP_Check}" />
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource OP_Hint}" Text="Choosing &quot;Don't ask me again&quot; in a delete dialog turns the matching option off. Turn it back on here." />
                                        <Button Margin="0,8,0,0" HorizontalAlignment="Left" Command="{Binding ResetConfirmationsCommand}" Content="Turn all confirmations back on" Style="{StaticResource OP_Small}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- =================== INFO (opened with the ! next to the gear) =================== -->
                    <TabItem Header="Info" Visibility="Collapsed">
                        <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="660" HorizontalAlignment="Left">
                                <Border Margin="0,0,0,12" Style="{StaticResource OP_Box}">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,4" Style="{StaticResource OP_Heading}" Text="EDITING WHILE A RUN IS GOING" />
                                        <TextBlock Style="{StaticResource OP_Hint}" Text="You can edit the stages in NINA's Advanced Sequencer and the targets here while the planner runs. This is when each change is used:" />
                                        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="1 Begin and 4 End" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource OP_Hint}" Text="Used the next time the stage runs (for 1 Begin: after the next weather stop or the next night)." />
                                        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="2 Start of each target" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource OP_Hint}" Text="The planner copies this stage when a target starts. A change is used from the next target; the target being imaged has already run it." />
                                        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="3 While imaging (triggers)" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource OP_Hint}" Text="Also copied when a target starts, and again on Start sequence after a pause. A change is used from the next target, or after the next pause." />
                                        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="The running target block (e.g. &quot;M31&quot;) in the Advanced Sequencer" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource OP_Hint}" Text="While a target runs, the planner adds a temporary target block inside the Observatory Planner block. It holds copies of stages 2 and 3 for that target only. Changes made inside it affect only the target running now and are lost when it ends. Edit stages 2 and 3 instead." />
                                        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Targets and exposure rows (this panel)" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource OP_Hint}" Text="Used right away: the next frame takes the current exposure rows, and the next target is chosen from the current list. Progress is saved after every frame." />
                                        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="⚙ Options" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource OP_Hint}" Text="Used the next time each setting is needed (for example the guiding limit before the next frame). The run mode can only be changed while stopped." />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,0,0,12" Style="{StaticResource OP_Box}">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,4" Style="{StaticResource OP_Heading}" Text="PAUSE AND START SEQUENCE" />
                                        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="When Pause is available" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource OP_Hint}" Text="From the start of 1 Begin until 4 End starts. While waiting for safe or for the next night nothing is powered: use Stop, and Run when you're ready." />
                                        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Pause now" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource OP_Hint}" Text="Stops whatever is running: a frame being taken is dropped; a slew, centering, autofocus, a wait or 1 Begin is interrupted. A meridian flip, the dome shutter, park and the steps between targets finish first." />
                                        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Pause after this step" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource OP_Hint}" Text="The frame or instruction running now finishes first." />
                                        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Start sequence" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource OP_Hint}" Text="Checks the connections and the weather, then continues with the targets and settings as they are now. An interrupted 1 Begin continues from the step it stopped at. On the same target with the mount not moved only guiding restarts; if 2 Start of target was interrupted or the mount moved, it runs again. If the paused target was turned off, finished or is outside its time window, the next target is taken and the status says why." />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,0,0,12" Style="{StaticResource OP_Box}">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,4" Style="{StaticResource OP_Heading}" Text="ADDING SECTIONS IN THE ADVANCED SEQUENCER" />
                                        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Inside a stage: yes" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource OP_Hint}" Text="New instructions and instruction sets belong inside one of the four stages, for example a flats set inside 4 End. They run each time that stage runs; 4 End also runs on every unsafe shutdown." />
                                        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Directly in the Observatory Planner block: no" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource OP_Hint}" Text="A section placed between the stages (not inside one) does not run and is removed when the run starts. Known issue, on the to-do list." />
                                        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Outside the Observatory Planner block" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource OP_Hint}" Text="NINA's Start area runs once when NINA's sequence starts, before 1 Begin. Anything after the block or in NINA's End area runs only after the planner stops, when 4 End has already switched the equipment off." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <!--  gear and ! (info) at the right end of the tab row  -->
                <StackPanel Margin="0,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                <Button Command="{Binding GoOptionsCommand}" ToolTip="Options">
                    <Button.Style>
                        <Style BasedOn="{StaticResource OP_Flat}" TargetType="Button">
                            <Setter Property="Padding" Value="8,4" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPlannerTab}" Value="2">
                                    <Setter Property="Foreground" Value="{StaticResource OP_Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Width="20" Height="20" Data="M12,9 A3,3 0 1 1 11.99,9 Z M19.4,15 A1.65,1.65 0 0 0 19.73,16.82 L19.79,16.88 A2,2 0 1 1 16.96,19.71 L16.9,19.65 A1.65,1.65 0 0 0 15.08,19.32 A1.65,1.65 0 0 0 14.08,20.83 V21 A2,2 0 1 1 10.08,21 V20.91 A1.65,1.65 0 0 0 9,19.4 A1.65,1.65 0 0 0 7.18,19.73 L7.12,19.79 A2,2 0 1 1 4.29,16.96 L4.35,16.9 A1.65,1.65 0 0 0 4.68,15.08 A1.65,1.65 0 0 0 3.17,14.08 H3 A2,2 0 1 1 3,10.08 H3.09 A1.65,1.65 0 0 0 4.6,9 A1.65,1.65 0 0 0 4.27,7.18 L4.21,7.12 A2,2 0 1 1 7.04,4.29 L7.1,4.35 A1.65,1.65 0 0 0 8.92,4.68 H9 A1.65,1.65 0 0 0 10,3.17 V3 A2,2 0 1 1 14,3 V3.09 A1.65,1.65 0 0 0 15,4.6 A1.65,1.65 0 0 0 16.82,4.27 L16.88,4.21 A2,2 0 1 1 19.71,7.04 L19.65,7.1 A1.65,1.65 0 0 0 19.32,8.92 V9 A1.65,1.65 0 0 0 20.83,10 H21 A2,2 0 1 1 21,14 H20.91 A1.65,1.65 0 0 0 19.4,15 Z" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeLineJoin="Round" StrokeThickness="1.8" />
                </Button>
                <Button Command="{Binding GoInfoCommand}" ToolTip="Info: what happens when you edit while a run is going">
                    <Button.Style>
                        <Style BasedOn="{StaticResource OP_Flat}" TargetType="Button">
                            <Setter Property="Padding" Value="6,4" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPlannerTab}" Value="3">
                                    <Setter Property="Foreground" Value="{StaticResource OP_Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid Width="20" Height="20">
                        <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" />
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="!" />
                    </Grid>
                </Button>
                </StackPanel>
            </Grid>
        </Grid>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
