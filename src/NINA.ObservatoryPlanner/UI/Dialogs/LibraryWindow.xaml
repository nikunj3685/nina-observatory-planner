<Window
    x:Class="NINA.ObservatoryPlanner.UI.Dialogs.LibraryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="580"
    Background="{DynamicResource BackgroundBrush}"
    Foreground="{DynamicResource PrimaryBrush}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    WindowStyle="ToolWindow">
    <DockPanel>
        <Border Padding="16,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" DockPanel.Dock="Bottom">
            <DockPanel>
                <Button MinWidth="84" Content="Close" DockPanel.Dock="Right" IsCancel="True" Style="{DynamicResource OP_Btn}" />
                <Button HorizontalAlignment="Left" Click="Browse_Click" Content="Browse…" Style="{DynamicResource OP_Small}" ToolTip="Open a file from another folder" />
            </DockPanel>
        </Border>
        <StackPanel Margin="16,12">
            <TextBlock x:Name="empty" Margin="0,4" Opacity="0.7" TextWrapping="Wrap" />
            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="list">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,4" Padding="10,8" BorderThickness="1" CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="BorderBrush" Value="#E3A646" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Click="Open_Click" Content="Open" Style="{DynamicResource OP_Small}" />
                                        <Button Margin="0" Click="Delete_Click" Content="Delete" Style="{DynamicResource OP_Small}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="12" Opacity="0.65" Text="{Binding Meta}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </DockPanel>
</Window>
