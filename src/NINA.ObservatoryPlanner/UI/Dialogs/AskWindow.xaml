<Window
    x:Class="NINA.ObservatoryPlanner.UI.Dialogs.AskWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Binding Heading}"
    MinWidth="380"
    MaxWidth="560"
    Background="{DynamicResource BackgroundBrush}"
    Foreground="{DynamicResource PrimaryBrush}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner"
    WindowStyle="ToolWindow">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <DockPanel>
        <Border Padding="16,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" DockPanel.Dock="Bottom">
            <ItemsControl HorizontalAlignment="Right" ItemsSource="{Binding Buttons}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button MinWidth="84" Margin="8,0,0,0" Click="Answer_Click" Content="{Binding Label}" IsCancel="{Binding IsCancel}" IsDefault="{Binding IsDefault}" Style="{Binding Style}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <StackPanel Margin="16,14,16,14">
            <TextBlock Margin="0,0,0,8" FontSize="16" FontWeight="SemiBold" Text="{Binding Heading}" TextWrapping="Wrap" />
            <TextBlock MaxWidth="520" Text="{Binding Message}" TextWrapping="Wrap" />
            <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Choices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Margin="0,0,0,6" GroupName="AskChoice" IsChecked="{Binding IsSelected}" Style="{DynamicResource OP_Card}">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                <TextBlock Margin="0,2,0,0" FontSize="12" Opacity="0.7" Text="{Binding Description}" TextWrapping="Wrap" />
                            </StackPanel>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Visibility="{Binding HasText, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Margin="0,0,0,4" FontSize="12" Opacity="0.7" Text="{Binding TextLabel}" />
                <TextBox x:Name="textBox" MinWidth="320" Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#E0645C" Text="{Binding TextError}" TextWrapping="Wrap" />
            </StackPanel>
            <CheckBox Margin="0,12,0,0" Content="{Binding CheckText}" IsChecked="{Binding IsChecked}" Style="{DynamicResource OP_Check}" Visibility="{Binding HasCheck, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </DockPanel>
</Window>
